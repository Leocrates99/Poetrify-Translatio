{"id":"tlg0062.tlg071","lang":"grc","author":"Luciano","authorId":"tlg0062","title":"La podagra","titleOrig":"Ποδάγρα","titleState":"it","titleEn":"Podagra","genre":"satira","epoch":"imperiale","inferred":true,"kind":"versi","source":{"urn":"urn:cts:greekLit:tlg0062.tlg071","repo":"canonical-greekLit","file":"tlg0062.tlg071.perseus-grc2.xml","edition":"Lucian. Luciani Samosatensis Opera, Vol. 3. Jacobitz, Karl, editor. Leipzig: Teubner, 1913.","license":"CC BY-SA (Perseus Digital Library)"},"citation":"libro.verso","units":[{"loc":"1","t":"Πόδαγρος"},{"loc":"1.1","t":"ὦ στυγνὸν οὔνομʼ, ὦ θεοῖς στυγούμενον,"},{"loc":"1.2","t":"ποδάγρα, πολυστένακτε, Κωκυτοῦ τέκνον,"},{"loc":"1.3","t":"ἣν Ταρτάρου κευθμῶσιν ἐν βαθυσκίοις"},{"loc":"1.4","t":"Μέγαιρʼ Ἐρινὺς γαστρὸς ἐξεγείνατο"},{"loc":"1.5","t":"μαζοῖσί τʼ ἐξέθρεψε, καὶ πικρῷ βρέφει"},{"loc":"1.6","t":"εἰς χεῖλος ἐστάλαξεν Ἀλληκτὼ γάλα,"},{"loc":"1.7","t":"τίς τὴν δυσώνυμόν σε δαιμόνων ἄρα"},{"loc":"1.8","t":"εἰς φῶς ἀνῆκεν; ἦλθες ἀνθρώποις βλάβος."},{"loc":"1.9","t":"Εἰ γὰρ τεθνῶσιν ἀμπλακημάτων τίσις"},{"loc":"1.10","t":"βροτοῖς ὀπηδεῖ τῶν ἔδρασαν ἐν φάει,"},{"loc":"1.11","t":"οὐ Τάνταλον ποτοῖσιν, οὐδʼ Ἰξίονα"},{"loc":"1.12","t":"τροχῷ στροβητόν, οὐδὲ Σίσυφον πέτρῳ"},{"loc":"1.13","t":"ἔδει κολάζειν ἐν δόμοισι Πλουτέως,"},{"loc":"1.14","t":"ἁπλῶς δὲ πάντας τοὺς κακῶς δεδρακότας"},{"loc":"1.15","t":"τοῖς σοῖς προσάπτειν ἀρθροκηδέσιν πόνοις,"},{"loc":"1.16","t":"ὥς μου τὸ λυπρὸν καὶ ταλαίπωρον δέμας"},{"loc":"1.17","t":"χειρῶν ἀπʼ ἄκρων εἰς ἄκρας ποδῶν βάσεις"},{"loc":"1.18","t":"ἰχῶρι φαύλῳ καὶ πικρῷ χυμῷ χολῆς"},{"loc":"1.19","t":"πνεύματι βιαίῳ τόδε διασφίγγον πόρους"},{"loc":"1.20","t":"ἕστηκε καὶ μεμυκὸς ἐπιτείνει πόνους."},{"loc":"1.21","t":"Σπλάγχνων δʼ ἐπʼ αὐτῶν διάπυρον τρέχει κακόν,"},{"loc":"1.22","t":"δίναισι φλογμῶν σάρκα πυρπολούμενον,"},{"loc":"1.23","t":"ὁποῖα κρητὴρ μεστὸς Αἰτναίου πυρὸς"},{"loc":"1.24","t":"ἢ Σικελὸς αὐλὼν ἁλιπόρου διασφάγος,"},{"loc":"1.25","t":"ὅπου δυσεξέλικτα κυματούμενος"},{"loc":"1.26","t":"σήραγξι πετρῶν σκολιὸς εἱλεῖται κλύδων."},{"loc":"1.27","t":"Ὦ δυστέκμαρτον πᾶσιν ἀνθρώποις τέλος,"},{"loc":"1.28","t":"ὡς εἰς μάτην σε πάντες ἀμφιθάλπομεν"},{"loc":"1.29","t":"ἐλπίδι ματαίᾳ μωρὰ βουκολούμενοι."},{"loc":"2","t":"Χόρος"},{"loc":"2.30","t":"ἀνὰ Δίνδυμον Κυβήβης"},{"loc":"2.31","t":"Φρύγες ἔνθεον ὀλολυγὴν"},{"loc":"2.32","t":"ἁπαλῷ τελοῦσιν Ἄττῃ,"},{"loc":"2.33","t":"καὶ πρὸς μέλος κεραύλου"},{"loc":"2.34","t":"Φρυγίου κατʼ ὄρεα Τμώλου"},{"loc":"2.35","t":"κῶμον βοῶσι Λυδοί·"},{"loc":"2.36","t":"παραπλῆγες δʼ ἀμφὶ ῥόπτροις"},{"loc":"2.37","t":"κελαδοῦσι Κρητὶ ῥυθμῷ"},{"loc":"2.38","t":"νόμον Κορύβαντες εὐάν."},{"loc":"2.39","t":"Κλάζει βρίθουσα σάλπιγξ"},{"loc":"2.40","t":"Ἄρει κρέκουσα θούρῳ"},{"loc":"2.41","t":"πολεμηίαν ἀϋτήν."},{"loc":"2.42","t":"Ἡμεῖς δὲ σοί, Ποδάγρα,"},{"loc":"2.43","t":"πρώταις ἔαρος ἐν ὥραις"},{"loc":"2.44","t":"μύσται τελοῦμεν οἴκτους,"},{"loc":"2.45","t":"ὅτε πᾶς χλοητόκοισι"},{"loc":"2.46","t":"ποίαις τέθηλε λειμών,"},{"loc":"2.47","t":"Ζεφύρου δὲ δένδρα πνοιαῖς"},{"loc":"2.48","t":"ἁπαλοῖς κομᾷ πετήλοις,"},{"loc":"2.49","t":"ἁ δύσγαμος κατʼ οἴκους"},{"loc":"2.50","t":"μερόπων θροεῖ χελιδών,"},{"loc":"2.51","t":"καὶ νυκτέροις καθʼ ὕλαν"},{"loc":"2.52","t":"τὸν Ἴτυν στένει δακρύουσʼ"},{"loc":"2.53","t":"Ἀτθὶς γόοις ἀηδών."},{"loc":"3","t":"Πόδαγρος"},{"loc":"3.54","t":"ὤμοι πόνων ἀρωγόν, ὦ τρίτου ποδὸς"},{"loc":"3.55","t":"μοῖραν λελογχὸς βάκτρον, ἐξέρειδέ μου"},{"loc":"3.56","t":"βάσιν τρέμουσαν καὶ κατίθυνον τρίβον,"},{"loc":"3.57","t":"ἴχνος βέβαιον ὡς ἐπιστήσω πέδῳ."},{"loc":"3.58","t":"Ἔγειρε, τλῆμον, γυῖα δεμνίων ἄπο"},{"loc":"3.59","t":"καὶ λίπε μελάθρων τὴν ὑπώροφον στέγην."},{"loc":"3.60","t":"Σκέδασον δʼ ἀπʼ ὄσσων νύχιον ἀέρος βάθος"},{"loc":"3.61","t":"μολὼν θύραζε καὶ πρὸς ἡλίου φάος"},{"loc":"3.62","t":"ἀθόλωτον αὔραν πνεύματος φαιδροῦ σπάσον·"},{"loc":"3.63","t":"δέκατον γὰρ ἤδη τοῦτο πρὸς πέμπτῳ φάει,"},{"loc":"3.64","t":"ἐξ οὗ ζόφῳ σύγκλειστος ἡλίου δίχα"},{"loc":"3.65","t":"εὐναῖς ἐν ἀστρώτοισι τείρομαι δέμας."},{"loc":"3.66","t":"Ψυχὴ μὲν οὖν μοι καὶ προθυμία πάρα"},{"loc":"3.67","t":"βάσεις ἀμείβειν ἐπὶ θύρας ὡρμημένῳ,"},{"loc":"3.68","t":"δέμας δὲ νωθρὸν οὐχ ὑπηρετεῖ πόθοις."},{"loc":"3.69","t":"Ὅμως δʼ ἐπείγου, θυμέ, γιγνώσκων ὅτι"},{"loc":"3.70","t":"πτωχὸς ποδαγρῶν, περιπατεῖν μὲν ἂν θέλῃ"},{"loc":"3.71","t":"καὶ μὴ δύνηται, τοῦτον ἐν νεκροῖς τίθει."},{"loc":"3.72","t":"Ἀλλʼ εἶα."},{"loc":"3.73","t":"Τίνες γὰρ οἵδε βάκτρα νωμῶντες χεροῖν,"},{"loc":"3.74","t":"κάρηνα φύλλοις ἀκτέας καταστεφεῖς;"},{"loc":"3.75","t":"τίνι δαιμόνων ἄγουσι κωμαστὴν χορόν;"},{"loc":"3.76","t":"μῶν, Φοῖβε Παιάν, σὸν γεραίρουσιν σέβας;"},{"loc":"3.77","t":"ἀλλʼ οὐ στέφονται Δελφίδος φύλλῳ δάφνης."},{"loc":"3.78","t":"Ἢ μή τις ὕμνος Βακχίῳ κωμάζεται;"},{"loc":"3.79","t":"ἀλλ’ οὐκ ἔπεστι κισσίνη σφραγὶς κόμαις."},{"loc":"3.80","t":"Τίνες ποθ’ ἡμῖν, ὦ ξένοι, βεβήκατε;"},{"loc":"3.81","t":"αὐδᾶτε καὶ πρόεσθε νημερτῆ λόγον."},{"loc":"3.82","t":"Τίς δ’ ἔστιν, ἣν ὑμνεῖτε, λέξατ’, ὦ φίλοι."},{"loc":"4","t":"Χόρος"},{"loc":"4.83","t":"Σὺ δ’ ὢν τίς ἡμᾶς καὶ τίνων προσεννέπεις;"},{"loc":"4.84","t":"ὡς γάρ σε βάκτρον καὶ βάσις μηνύετον,"},{"loc":"4.85","t":"μύστην ὁρῶμεν τῆς ἀνικήτου θεᾶς."},{"loc":"5","t":"Πόδαγρος"},{"loc":"5.86","t":"Εἶς εἰμι κἀγὼ τῆς θεᾶς ἐπάξιος;"},{"loc":"6","t":"Χόρος"},{"loc":"6.87","t":"Τὰν μὲν Κυπρίαν Ἀφροδίταν"},{"loc":"6.88","t":"σταγόνων προπεσοῦσαν ἀπ’ αἰθέρος"},{"loc":"6.89","t":"ἀνεθρέψατο χόσμιον ἁρμογὰν"},{"loc":"6.90","t":"ἁλίοις ἐνὶ κύμασι Νηρεύς."},{"loc":"6.91","t":"Τὰν δ’ Ὠχεανοῦ παρὰ παγαῖς"},{"loc":"6.92","t":"Ζανὸς παράκοιτιν Ὀλυμπίου"},{"loc":"6.93","t":"λευκώλενον εὐρέσι κόλποις"},{"loc":"6.94","t":"Ἥραν ἐτιθήνατο Τηθύς."},{"loc":"6.95","t":"Κορυφαῖσι δὲ κρατὸς ἐν ἀφθίτου"},{"loc":"6.96","t":"ἐλόχευσε κόρας ἄτρομον φυὰν"},{"loc":"6.97","t":"Κρονίδας, μέγ’ ἄριστος Ὀλυμπίων,"},{"loc":"6.98","t":"τὰν ἐγρεκύδοιμον ᾿Αθάναν."},{"loc":"6.99","t":"Τὰν δ’ ἁμετέραν θεὸν ὀλβίαν"},{"loc":"6.100","t":"ὁ γέρων λιπαραῖσιν ἐν ἀγκάλαις"},{"loc":"6.101","t":"πρώταν ἐλόχευσεν Ὁφίων."},{"loc":"6.102","t":"Ὅτ’ ἐπαύσατο μὲν σκότιον χάος"},{"loc":"6.103","t":"ἀνέτειλέ τε λαμπέτις ἀὼς"},{"loc":"6.104","t":"καὶ παμφαὲς ἀελίου σέλας."},{"loc":"6.105","t":"Τότε καὶ Ποδάγρας ἐφάνη κράτος."},{"loc":"6.106","t":"Ὅτε γὰρ λαγόνων σε τεκοῦσα"},{"loc":"6.107","t":"Μοῖρα Κλωθὼ τότ’ ἔλουσεν,"},{"loc":"6.108","t":"ἐγέλασσεν ἅπαν σέλας οὐρανοῦ,"},{"loc":"6.109","t":"μέγα δ’ ἔκτυπεν εὔδιος αἰθήρ·"},{"loc":"6.110","t":"τὰν δ’ εὐγλαγέτοις ἐνὶ μαξοῖς"},{"loc":"6.111","t":"εὔολβος ἐθρέψατο Πλούτων."},{"loc":"7","t":"Πόδαγρος"},{"loc":"7.112","t":"Τίσιν δὲ τελεταῖς ὀργιάξει προσπόλους;"},{"loc":"8","t":"Χόρος"},{"loc":"8.113","t":"Οὐχ αἷμα λάβρον προχέομεν ἀποτομαῖς σιδάρου,"},{"loc":"8.114","t":"οὐ τριχὸς ἀφέτου λυγίζεται στροφαῖσιν αὐχήν,"},{"loc":"8.115","t":"οὐδὲ πολυκρότοις ἀστραγάλοις πέπληγε νῶτα,"},{"loc":"8.116","t":"οὐδ’ ὠμὰ λακιστὰ κρέα σιτούμεθα ταύρων·"},{"loc":"8.117","t":"ὅτε δὲ πτελέας ἔαρι βρύει τὸ λεπτὸν ἄνθος"},{"loc":"8.118","t":"καὶ πολυκέλαδος κόσσυφος ἐπὶ κλάδοισιν ᾄδει,"},{"loc":"8.119","t":"τότε διὰ μελέων ὀξὺ βέλος πέπηγε μύσταις,"},{"loc":"8.120","t":"ἀφανές, κρύφιον. Δεδυκὸς ὑπὸ μυχοῖσι γυίων,"},{"loc":"8.121","t":"πόδα, γόνυ, κοτύλην. Ἀστραγάλους. Ἰσχία. Μηρούς,"},{"loc":"8.122","t":"χέρας, ὠμοπλάτας, βραχίονας, κορωνά, καρποὺς"},{"loc":"8.123","t":"ἔσθει, νέμεται, φλέγει, κρατεῖ, πυρο,. Μαλάσσει,"},{"loc":"8.124","t":"μέχρις ἂν ἡ θεὸς τὸν πόνον ἀποφυγεῖν κελεύσῃ."},{"loc":"9","t":"Πόδαγρος"},{"loc":"9.125","t":"Εἷς ἆρα κἀγὼ τῶν κατωργιασμένων"},{"loc":"9.126","t":"ἔλαθον ὑπάρχων; τοιγὰρ ἧκε πρευμενὴς"},{"loc":"9.127","t":"δαίμων φανεῖσα. Σὺν δ’ ἐγὼ μύσταις ὁμοῦ"},{"loc":"9.128","t":"ὕμνων κατάρξω τὸ ποδαγρῶν ᾄδων μέλος."},{"loc":"10","t":"Χόρος"},{"loc":"10.129","t":"Σῖγα μὲν αἰθὴρ νήνεμος ἔστω,"},{"loc":"10.130","t":"καὶ πᾶς ποδαγρῶν εὐφημείτω."},{"loc":"10.131","t":"Ἴδε, πρὸς θυμέλας ἡ κλινοχαρὴς"},{"loc":"10.132","t":"βαίνει δαίμων σκίπωνι βάσιν"},{"loc":"10.133","t":"στηριξομένη. Χαίροις μακάρων"},{"loc":"10.134","t":"πολὺ πραοτάτη καὶ σοῖς προπόλοις"},{"loc":"10.135","t":"ἵλαος ἔλθοις ὄμματι φαιδρῷ."},{"loc":"10.136","t":"Δοίης δὲ πόνοις λύσιν ὠκεῖαν"},{"loc":"10.137","t":"ταῖσδ’ εἰαριναῖσιν ἐν ὥραις."},{"loc":"11","t":"Ποδάγρα"},{"loc":"11.138","t":"Τίς τὴν ἀνίκητόν με δεσπότιν πόνων"},{"loc":"11.139","t":"οὐκ οἶδε Ποδάγραν τῶν ἐπὶ χθονὸς βροτῶν;"},{"loc":"11.140","t":"ἣν οὔτε λιβάνων ἀτμὸς ἐξιλάσκεται"},{"loc":"11.141","t":"οὔτε χυθὲν αἷμα βωμίοις παρ’ ἐμπύροις,"},{"loc":"11.142","t":"οὐ ναὸς ὄλβου περικρεμὴς ἀγάλμασιν,"},{"loc":"11.143","t":"ἣν οὔτε Παιὰν φαρμάκοις νικᾶν σθένει,"},{"loc":"11.144","t":"πάντων ἰατρὸς τῶν ἐν οὐρανῷ θεῶν."},{"loc":"11.145","t":"Οὐ παῖς ὁ Φοίβου πολυμαθὴς Ἀσκληπιός."},{"loc":"11.146","t":"Ἐξ οὗ γὰρ ἐφύη πρῶτον ἀνθρώποις γένος,"},{"loc":"11.147","t":"τολμῶσι πάντες τοὐμὸν ἐκβαλεῖν σθένος,"},{"loc":"11.148","t":"κυκῶντες αἰεὶ φαρμάκων τεχνήματα."},{"loc":"11.149","t":"Ἄλλος γὰρ ἄλλην ἐπ’ ἐμὲ πειράξει τέχνην·"},{"loc":"11.150","t":"τρίβουσιν ἀρνόγλωσσα καὶ σέλινά μοι"},{"loc":"11.151","t":"καὶ φύλλα θριδάκων καὶ νομαίαν ἀνδράχνην."},{"loc":"11.152","t":"Ἄλλοι πράσιον, οἱ δὲ ποταμογείτονα,"},{"loc":"11.153","t":"ἄλλοι κνίδας τρίβουσιν, ἄλλοι σύμφυτον,"},{"loc":"11.154","t":"ἄλλοι φακοὺς φέρουσι τοὺς ἐκ τελμάτων."},{"loc":"11.155","t":"Σταφυλῖνον ἑφθόν, οἱ δὲ φύλλα Περσικῶν,"},{"loc":"11.156","t":"ὑοσκύαμον, μήκωνα, βολβούς, σίδια,"},{"loc":"11.157","t":"ψύλλιον, λίβανον. Ῥίζαν ἑλλεβόρου, νίτρον,"},{"loc":"11.158","t":"τῆλιν μετ’ οἴνου, γυρίνην, κολλάμφακον,"},{"loc":"11.159","t":"κυπαρισσίνην κηκῖδα, γῦριν κριθίνην,"},{"loc":"11.160","t":"χράμβης ἀπέφθου φύλλα, γύψον ἔκ Πάρου,"},{"loc":"11.161","t":"σπυράθους ὀρείας αἰγός, ἀνθρώπου κόπρον,"},{"loc":"11.162","t":"ἄλευρα κυάμων, ἄνθος ᾿Ασσίου λίθου·"},{"loc":"11.163","t":"ἕψουσι φρύνους, μυγαλᾶς, σαύρας, γαλᾶς,"},{"loc":"11.164","t":"βατράχους, ὑαίνας, τραγελάφους, ἀλώπεκας."},{"loc":"11.165","t":"Ποῖον μέταλλον οὐ πεπείρασται βροτοῖς;"},{"loc":"11.166","t":"τίς οὐχὶ χυλός; ποῖον οὐ δένδρου δάχρυ;"},{"loc":"11.167","t":"ξῴων ἁπάντων ὀστά, νεῦρα, δέρματα,"},{"loc":"11.168","t":"στέαρ, αἷμα. Μυελός, οὖρον, ἀπόπατος, γάλα."},{"loc":"11.169","t":"Πίνουσιν οἱ μὲν τὸ διὰ τεσσάρων ἄκος,"},{"loc":"11.170","t":"οἱ δὲ τὸ δι᾿ ὀχτώ, τὸ δὲ δι᾿ ἑπτὰ πλείονες."},{"loc":"11.171","t":"Ἄλλος δὲ πίνων τὴν ἱερὰν καθαίρεται,"},{"loc":"11.172","t":"ἄλλος ἐπαοιδαῖς ἐπιθετῶν ἐμπαίζεται,"},{"loc":"11.173","t":"Ἰουδαῖος ἕτερον μωρὸν ἐξᾴδει λαβών."},{"loc":"11.174","t":"Ὁ δὲ θεραπείαν ἔλαβε παρὰ τῆς Κυρράνης."},{"loc":"11.175","t":"Ἐγὼ δὲ τούτοις πᾶσιν οἰμώξειν λέγω"},{"loc":"11.176","t":"καὶ τοῖς ποιοῦσι ταῦτα καὶ πειρῶσί με"},{"loc":"11.177","t":"εἴωθ’ ἀπαντᾶν μᾶλλον ὀργιλωτέρα·"},{"loc":"11.178","t":"τοῖσι δὲ φρονοῦσι μηδὲν ἀντίξουν ἐμοὶ"},{"loc":"11.179","t":"ἤπιον ἔχω νοῦν εὐμενής τε γίνομαι."},{"loc":"11.180","t":"Ὁ γὰρ μεταλαβὼν τῶν ἐμῶν μυστηρίων"},{"loc":"11.181","t":"πρῶτον μὲν εὐθὺς εὐστομεῖν διδάσκεται"},{"loc":"11.182","t":"τέρπων ἅπαντας, εὐτραπέλους λέγων λόγους·"},{"loc":"11.183","t":"πᾶσιν δ’ ὁρᾶται μετὰ γέλωτος καὶ κρότου."},{"loc":"11.184","t":"Ὅτ’ ἐπὶ τὰ λουτρὰ φερόμενος βαστάζεται."},{"loc":"11.185","t":"Ἄτη γάρ, ἣν Ὅμηρος εἶπεν, εἰμ’ ἐγώ,"},{"loc":"11.186","t":"βαίνουσ’ ἐπ᾿ ἀνδρῶν κρᾶτα καὶ βάσεις ποδῶν"},{"loc":"11.187","t":"ἁπαλὰς ἔχουσα, παρὰ δὲ τοῖς πολλοῖς βροτῶν"},{"loc":"11.188","t":"Ποδάγρα καλοῦμαι, γινομένη ποδῶν ἄγρα."},{"loc":"11.189","t":"Ἀλλ’ εἶα μύσται πάντες ὀργίων ἐμῶν,"},{"loc":"11.190","t":"γεραίρεθ’ ὕμνοις τὴν ἀνίκητον θεάν."},{"loc":"12","t":"Χόρος"},{"loc":"12.191","t":"Ἀδαμάντινον ἦθος ἔχουσα κόρα,"},{"loc":"12.192","t":"πουλυσθενές, ὀβριμόθυμε θεά,"},{"loc":"12.193","t":"κλύε σῶν ἱερῶν μερόπων ἐνοπάς."},{"loc":"12.194","t":"Μέγα σὸν κράτος, ὀλβιόφρον Ποδάγρα,"},{"loc":"12.195","t":"τὰν καὶ Διὸς ὠκὺ πέφρικε βέλος,"},{"loc":"12.196","t":"τρομέει δέ σε κύμαθ’ ἁλὸς βυθίας,"},{"loc":"12.197","t":"τρομέει βασιλεὺς ἐνέρων Ἀΐδας,"},{"loc":"12.198","t":"ἐπιδεσμοχαρές, κατακλινοβατές,"},{"loc":"12.199","t":"κολυσιδρόμα, βασαναστραγάλα,"},{"loc":"12.200","t":"σφυροπρησιπύρα, μογισαψεδάφα,"},{"loc":"12.201","t":"δοιδυκοφόβα, γονυκαυσαγρύπνα,"},{"loc":"12.202","t":"περικονδυλοπωρυφίλα,"},{"loc":"12.203","t":"γονυκαμψεπίκυρτε Ποδάγρα."},{"loc":"13","t":"Ἄγγελος"},{"loc":"13.204","t":"Δέσποινα, καιρίῳ γὰρ ἤντησας ποδί,"},{"loc":"13.205","t":"ἄκου’, ἔπος γὰρ οὐκ ἐτώσιον φέρω,"},{"loc":"13.206","t":"ἀλλ’ ἔστι πρᾶξις τῶν λόγων συνέμπορος·"},{"loc":"13.207","t":"ἐγὼ γάρ, ὡς ἔταξας, ἠρέμῳ ποδὶ"},{"loc":"13.208","t":"πόλεις ἰχνεύων πάντας ἠρεύνων δόμους"},{"loc":"13.209","t":"μαθεῖν ποθῶν εἴ τις σὸν οὐ τιμᾷ κράτος."},{"loc":"13.210","t":"Καὶ τῶν μὲν ἄλλων εἶδον ἥσυχον φρένα"},{"loc":"13.211","t":"νικωμένων, ἄνασσα, σαῖν βίᾳ χεροῖν,"},{"loc":"13.212","t":"δύω δὲ τώδε φῶτε τολμηρὼ θράσει"},{"loc":"13.213","t":"ἐφραξέτην λαοῖσι καὶ κατωμνύτην."},{"loc":"13.214","t":"Ὡς οὐκέτ’ ἔστι σὸν κράτος σεβάσμιον,"},{"loc":"13.215","t":"ἀλλ’ ἔκβολον βροτῶν σε θήσουσιν βίου."},{"loc":"13.216","t":"Διόπερ κραταιῷ συνοχμάσας δεσμῷ πόδα"},{"loc":"13.217","t":"πεμπταῖος ἥκω στάδια διανύσας δύο."},{"loc":"14","t":"Ποδάγρα"},{"loc":"14.218","t":"Ὡς κραιπνὸς ἔπτης, ἀγγέλων ὤκιστέ μοι."},{"loc":"14.219","t":"Τίνος δὲ καὶ γῆς ὅρια δυσβάτου λιπὼν"},{"loc":"14.220","t":"ἥκεις; σαφῶς μήνυσον, ὡς εἰδῶ τάχος."},{"loc":"15","t":"Ἄγγελος"},{"loc":"15.221","t":"Πρῶτον μὲν ἔλιπον πέντε βαθμῶν κλίμακα,"},{"loc":"15.222","t":"ξύλων τρέμουσαν διαλύτοισιν ἁρμογαῖς,"},{"loc":"15.223","t":"ὅθεν μὲ δέχεται κορδυβαλλῶδες πέδον"},{"loc":"15.224","t":"σχληροῖσι ταρσοῖς ἀντερεῖδον κρούμασιν."},{"loc":"15.225","t":"Ὅπερ διανύσας ἴχνεσιν ἀλγεινοῖς ἐγὼ"},{"loc":"15.226","t":"ἐστρωμένην χάλιξιν εἰσέβην ὁδὸν"},{"loc":"15.227","t":"καὶ δυσπάτητον ὀξέσιν κέντροις λίθων."},{"loc":"15.228","t":"Μεθ’ ἣν ὀλίσθῳ περιπεσὼν λείας ὁδοῦ"},{"loc":"15.229","t":"ἔσπευδον εἰς τὸ πρόσθε, διάλυτος δέ μου"},{"loc":"15.230","t":"ἔσυρεν ὀπίσω πηλὸς ἀσθενῆ σφυρά,"},{"loc":"15.231","t":"δι᾿ ἧς περῶντι νότιος ἐκ μελῶν ἱδρὼς"},{"loc":"15.232","t":"ἔρρει βάσιν μου σαθρὰν ἐκλελυμένῳ."},{"loc":"15.233","t":"Ὅθεν μὲ δέχεται πᾶν μέλος κεκμηκότα"},{"loc":"15.234","t":"πλατεῖα μὲν κέλευθος, ἀλλ’ οὐκ ἀσφαλής·"},{"loc":"15.235","t":"τὰ μὲν γὰρ ἔνθεν, τὰ δέ μ’ ἐχκεῖθ’ ὀχήματα"},{"loc":"15.236","t":"ἤπειγεν, ἠνάγκαξεν, ἔσπερχεν τρέχειν."},{"loc":"15.237","t":"Ἐγὼ δὲ νωθρὸν ἐλαφρὰ κουφίζων πόδα"},{"loc":"15.238","t":"δόχμιος ἔβαινον εἰς ὁδοῦ πέζαν στενήν,"},{"loc":"15.239","t":"ἕως ἀπήνη παραδράμῃ τροχήλατος·"},{"loc":"15.240","t":"μύστης γὰρ ὢν σὸς ταχὺ τρέχειν οὐκ ἔσθενον."},{"loc":"16","t":"Ποδάγρα"},{"loc":"16.241","t":"Οὐκ εἰς μάτην, βέλτιστε, πρᾶξις ἥδε σοι"},{"loc":"16.242","t":"ὀρθὼς πέπρακται. Τῇ δὲ σῇ προθυμίᾳ"},{"loc":"16.243","t":"ἴσαισι τιμαῖς ἀντισηκώσω χάριν."},{"loc":"16.244","t":"Ἔστω δέ σοι δώρημα θυμῆρες τόδε,"},{"loc":"16.245","t":"ἑξῆς τριετίας πειράσῃ κούφων πόνων."},{"loc":"16.246","t":"Ὑμεῖς δὲ μιαροὶ καὶ θεοῖς ἐχθίστατοι,"},{"loc":"16.247","t":"τίνες πότ’ ὄντες καὶ τίνων πεφυκότες"},{"loc":"16.248","t":"τολμᾶτε Ποδάγρας ἀνθαμιλλᾶσθαι κράτει,"},{"loc":"16.249","t":"τῆς οὐδ’ ὁ Κρονίδας οἶδε νικῆσαι βίαν;"},{"loc":"16.250","t":"λέγετ’, ὦ κάκιστοι· καὶ γὰρ ἡρώων ἐγὼ"},{"loc":"16.251","t":"ἐδάμασα πλείστους, ὥς γ’ ἐπίστανται σοφοί."},{"loc":"16.252","t":"Πρίαμος Ποδάρκης ποδαγρὸς ὢν ἐκλῄξετο·"},{"loc":"16.253","t":"ἔθανε δ’ Ἀχιλλεὺς ποδαγρὸς ὢν ὁ Πηλέως·"},{"loc":"16.254","t":"ὁ Βελλεροφόντης ποδαγρὸς ὢν ἐκαρτέρει·"},{"loc":"16.255","t":"Θηβῶν δυνάστης Οἰδίπους ποδαγρὸς ἦν·"},{"loc":"16.256","t":"ἐκ τῶν Πελοπιδῶν ποδαγρὸς ἦν ὁ Πλεισθένης·"},{"loc":"16.257","t":"Ποίαντος υἱὸς ποδαγρὸς ὢν ἦρχε στόλου"},{"loc":"16.258","t":"ἄλλος Ποδάρκης Θεσσαλῶν ἦν ἡγεμών,"},{"loc":"16.259","t":"ὅς, ἐπείπερ ἔπεσε Πρωτεσίλαος ἐν μάχῃ,"},{"loc":"16.260","t":"ὅμως ποδαγρὸς ὢν καὶ πονῶν ἦρχε στόλου·"},{"loc":"16.261","t":"Ἰθάκης ἄνακτα Λαρτιάδην Ὀδυσσέα"},{"loc":"16.262","t":"ἐγὼ κατέπεφνον. Οὐκ ἄκανθα τρυγόνος."},{"loc":"16.263","t":"Ὡς οὔτι χαιρήσοντες, ὦ δυσδαίμονες,"},{"loc":"16.264","t":"ἴσην πάθηθε κόλασιν οἷς δεδράκατε."},{"loc":"17","t":"Ἰατροὶ"},{"loc":"17.265","t":"Σύροι μέν ἐσμεν, ἐκ Δαμασκοῦ τῷ γένει,"},{"loc":"17.266","t":"λιμῷ δὲ πολλῷ καὶ πενίᾳ κρατούμενοι"},{"loc":"17.267","t":"γὴν καὶ θάλασσαν ἐφέπομεν πλανώμενοι·"},{"loc":"17.268","t":"ἔχομεν δὲ χρῖσμα πατροδώρητον τόδε,"},{"loc":"17.269","t":"ἐν ᾧ παρηγοροῦμεν ἀλγούντων πόνους."},{"loc":"18","t":"Ποδάγρα"},{"loc":"18.270","t":"Τί δὴ τὸ χρῖσμα καὶ τίς ἡ σκευή; φράσον."},{"loc":"19","t":"Ἰατρός"},{"loc":"19.271","t":"Μύστης με σιγᾶν ὅρκος οὐκ ἐᾷ φράσαι."},{"loc":"19.272","t":"Καὶ λοισθία θνήσκοντος ἐντολὴ πατρός,"},{"loc":"19.273","t":"ὃς ἔταξε κεύθειν φαρμάκου μέγα σθένος,"},{"loc":"19.274","t":"ὃ καὶ σὲ παύειν οἶδεν ἠγριωμένην."},{"loc":"20","t":"Ποδάγρα"},{"loc":"20.275","t":"Εἶτ’ ὦ κατάρατοι καὶ κακῶς ὀλούμενοι,"},{"loc":"20.276","t":"ἔστιν τις ἐν γῇ φαρμάκου δρᾶσις τόση,"},{"loc":"20.277","t":"ὃ χρισθὲν οἶδε τὴν ἐμὴν παῦσαι βίαν;"},{"loc":"20.278","t":"ἀλλ’ εἶα. Τήνδε σύμβασιν συνθώμεθα,"},{"loc":"20.279","t":"καὶ πειράσωμεν εἴτε φαρμάκου σθένος"},{"loc":"20.280","t":"ὑπέρτερον πέφυκεν εἴτ’ ἐμαὶ φλόγες."},{"loc":"20.281","t":"Δεῦτ’, ὦ σκυθρωπαί, πάντοθεν ποτώμεναι"},{"loc":"20.282","t":"βάσανοι, πάρεδροι τῶν ἐμῶν βακχευμάτων,"},{"loc":"20.283","t":"πελάζετ’ ἆσσον· καὶ σὺ μὲν ποδῶν ἄκρους"},{"loc":"20.284","t":"φλέγμαινε ταρσοὺς δακτύλων ποδῶν ἄχρι,"},{"loc":"20.285","t":"σὺ δὲ σφυροῖς ἔμβαινε, σὺ δὲ μηρῶν ἄπο"},{"loc":"20.286","t":"ἐς γόνατα λεῖβε πικρὸν ἰχώρων βάθος,"},{"loc":"20.287","t":"ὑμεῖς δὲ χειρῶν δακτύλους λυγίζετε."},{"loc":"21","t":"Πόνοι"},{"loc":"21.288","t":"Ἴδ’, ὡς ἔταξας πάντα σοι δεδράκαμεν·"},{"loc":"21.289","t":"κεῖνται βοῶντες οἱ ταλαίπωροι μέγα,"},{"loc":"21.290","t":"ἅπαντα γυῖα προσβολῇ στρεβλούμενοι."},{"loc":"22","t":"Ποδάγρα"},{"loc":"22.291","t":"Φέρετ’, ὦ ξένοι, μάθωμεν ἀτρεκέστατον,"},{"loc":"22.292","t":"εἰ χρισθὲν ὑμᾶς φάρμακον τόδ’ ὠφελεῖ."},{"loc":"22.293","t":"Εἰ γὰρ σαφῶς τόδ’ ἐστὶν ἀντίξουν ἐιιοί,"},{"loc":"22.294","t":"λείπουσα γαῖαν εἰς μυχοὺς εἶμι χθονός,"},{"loc":"22.295","t":"ἄϊστος, ἀφανής, πύματα Ταρτάρου βαθη."},{"loc":"23","t":"Ἰατρός"},{"loc":"23.296","t":"Ἰδού, κέχρισται, κοὐ χαλᾷ φλογμὸν πόνων."},{"loc":"24","t":"Πόδαγρος"},{"loc":"24.297","t":"Οἴμοι, παπαῖ γε, τείρομαι, διόλλυμαι,"},{"loc":"24.298","t":"ἅπαν πέπαρμαι γυῖον ἀσκόπῳ κακῷ·"},{"loc":"24.299","t":"οὐ Ζεὺς κεραυνοῦ τοῖον αἰωρεῖ βέλος,"},{"loc":"24.300","t":"οὐδεὶς θαλάσσης τοῖα μαίνεται κλύδων,"},{"loc":"24.301","t":"οὐδὲ στροβητὴ λαίλαπος τόσση βία."},{"loc":"24.302","t":"Μὴ κάρχαρον πορθεῖ με δῆγμα Κερβέρου;"},{"loc":"24.303","t":"μή τίς μ’ ἐχίδνης ἰὸς ἀμφιβόσκεται,"},{"loc":"24.304","t":"ἢ διαβρεχὴς ἰχῶρι Κενταύρου πέπλος;"},{"loc":"24.305","t":"ἐλέαιρ’, ἄνασσα, φάρμακον γὰρ οὔτ’ ἐμὸν"},{"loc":"24.306","t":"οὔτ’ ἄλλο δύναται σὸν ἀναχαιτίσαι δρόμον,"},{"loc":"24.307","t":"ψήφοις δὲ πάσαις πᾶν ἔθνος νικᾶς βροτῶν."},{"loc":"25","t":"Ποδάγρα"},{"loc":"25.308","t":"Παύσασθε.βάσανοι,καὶπόνους μειώσατε"},{"loc":"25.309","t":"τῶν μετανοούντων εἰς ἐμὴν ἔριν μολεῖν."},{"loc":"25.310","t":"Γινωσκέτω δὲ πᾶς τις ὡς μόνη θεῶν"},{"loc":"25.311","t":"ἄτεγχτος οὖσα φαρμάκοις οὐ πείθομαι."},{"loc":"26","t":"Χόρος"},{"loc":"26.312","t":"Οὔτε Διὸς βρονταῖς Σαλμωνέος ἤρισε βία,"},{"loc":"26.313","t":"ἀλλ’ ἔθανε ψολόεντι δαμεῖσα θεοῦ φρένα βέλει,"},{"loc":"26.314","t":"οὐκ ἐρίσας ἐχάρη Φοίβῳ σάτυρος Μαρσύας,"},{"loc":"26.315","t":"ἀλλὰ λιγὺ ψαίρει κείνου περὶ δέρμα πίτυϊ."},{"loc":"26.316","t":"Πένθος ἀείμνηστον δι’ ἔριν τοκὰς ἔσχε Νιόβη."},{"loc":"26.317","t":"Ἀλλ’ ἔτι μυρομένη προχέει πολὺ δάκρυ Σιπύλῳ."},{"loc":"26.318","t":"Μαιονία δ’ Ἀράχνη Τριτωνίδος ἦλθεν ἐς ἔριν,"},{"loc":"26.319","t":"ἀλλ’ ὀλέσασα τύπον καὶ νῦν ἔτι νήματα πλέκει·"},{"loc":"26.320","t":"οὐ γὰρ ἴσον μακάρων ὀργαῖς θράσος ἐστὶ μερόπων,"},{"loc":"26.321","t":"ὡς Διός, ὡς Δητοῦς, ὡς Παλλάδος, ὡς Πυθίου."},{"loc":"26.322","t":"Ἤπιον. Ὦ πάνδημε, φέροις ἄλγημα, Ποδάγρα,"},{"loc":"26.323","t":"κοῦφον, ἐλαφρόν, ἄδριμυ, βραχυβλαβές, ἀνώδυνον,"},{"loc":"26.324","t":"εὔφορον, εὔληκτον, ὀλιγοδρανές, εὐπερίπατον."},{"loc":"26.325","t":"Πολλαὶ μορφαὶ τῶν ἀτυχούντων,"},{"loc":"26.326","t":"μελέται δὲ πόνων καὶ τὸ σύνηθες"},{"loc":"26.327","t":"τοὺς ποδαγρῶντας παραμυθείσθω."},{"loc":"26.328","t":"Ὅθεν εὐθύμως, ὦ σύγκληροι,"},{"loc":"26.329","t":"λήσεσθε πόνων,"},{"loc":"26.330","t":"εἰ τὰ δοκηθέντ’ οὐκ ἐτελέσθη,"},{"loc":"26.331","t":"τοῖς δ’ ἀδοκήτοις πόρον εὗρε θεός."},{"loc":"26.332","t":"Πᾶς δ’ ἀνεχέσθω τῶν πασχόντων"},{"loc":"26.333","t":"ἐμπαιξόμενος καὶ σκωπτόμενος·"},{"loc":"26.334","t":"τοῖον γὰρ ἔφυ τόδε πρᾶγμα."}],"stats":{"units":360,"words":1786}}