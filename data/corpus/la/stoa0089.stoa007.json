{"id":"stoa0089.stoa007","lang":"la","author":"Claudiano","authorId":"stoa0089","title":"Fescinnina de nuptiis Honorii Augusti","titleOrig":null,"titleState":"assente","titleEn":"Fescinnina de nuptiis Honorii Augusti","genre":"epica","epoch":"tarda","inferred":true,"year":398,"yearKind":"certa","yearNote":"Carmi nuziali per la stessa occasione delle nozze di Onorio e Maria, inizio 398.","kind":"versi","source":{"urn":"urn:cts:latinLit:stoa0089.stoa007","repo":"canonical-latinLit","file":"stoa0089.stoa007.perseus-lat2.xml","edition":"Claudian, Volume 1. Platnauer, Maurice, editor. Harvard University Press: Cambridge, MA; London, England, 1922.","license":"CC BY-SA (Perseus Digital Library)"},"citation":"libro.verso","units":[{"loc":"1.1","t":"princeps corusco sidere pulclirior,"},{"loc":"1.2","t":"Parthis sagittas tendere doctior,"},{"loc":"1.3","t":"eques Gelonis imperiosior,"},{"loc":"1.4","t":"quae digna mentis laus erit arduae?"},{"loc":"1.5","t":"quae digna formae laus erit igneae?"},{"loc":"1.6","t":"te Leda mallet quam dare Castorem;"},{"loc":"1.7","t":"praefert Achilli te proprio Thetis;"},{"loc":"1.8","t":"victum fatetur Delos Apollinem:"},{"loc":"1.9","t":"credit minorem Lydia Liberum."},{"loc":"1.10","t":"Tu cum per altas impiger ilices"},{"loc":"1.11","t":"freno citatum cornipedem reges"},{"loc":"1.12","t":"ludentque ventis instabiles comae^"},{"loc":"1.13","t":"telis iacebunt sponte tuis ferae"},{"loc":"1.14","t":"gaudensque sacris vulneribus leo"},{"loc":"1.15","t":"admittet hastam morte superbior."},{"loc":"1.16","t":"Venus reversum spernit Adonidem,"},{"loc":"1.17","t":"damnat reductum Cynthia Virbium."},{"loc":"1.18","t":"Cum post labores sub platani voles"},{"loc":"1.19","t":"virentis umbra vel gelido specu"},{"loc":"1.20","t":"torrentiorem fallere Sirium"},{"loc":"1.21","t":"et membra somno fessa resolveris:"},{"loc":"1.22","t":"quantus uret tum Dryadas calor!"},{"loc":"1.23","t":"quot aestuantes ancipiti gradu"},{"loc":"1.24","t":"furtiva carpent oscula Naides!"},{"loc":"1.25","t":"quis vero acerbis horridior Scythis,"},{"loc":"1.26","t":"quis beluarum corde furentior,"},{"loc":"1.27","t":"qui, cum micantem te prope viderit,"},{"loc":"1.28","t":"non optet ultro servitium pati,"},{"loc":"1.29","t":"qui non catenas adripiat libens"},{"loc":"1.30","t":"colloque poscat vincula libero?"},{"loc":"1.31","t":"tu si nivalis per iuga Caucasi"},{"loc":"1.32","t":"saevas petisses pulcher Amazonas,"},{"loc":"1.33","t":"peltata pugnas desereret cohors"},{"loc":"1.34","t":"sexu recepto; patris et inmemor"},{"loc":"1.35","t":"inter frementes Hippolyte tubas"},{"loc":"1.36","t":"strictam securim languida poneret"},{"loc":"1.37","t":"et seminudo pectore cingulum"},{"loc":"1.38","t":"forti negatum solveret Herculi,"},{"loc":"1.39","t":"bellumque solus conficeret decor."},{"loc":"1.40","t":"Beata, quae te mox faciet virum"},{"loc":"1.41","t":"primisque sese iunget amoribus."},{"loc":"2.1","t":"Age cuncta nuptiali"},{"loc":"2.2","t":"redimita vere tellus"},{"loc":"2.3","t":"celebra toros eriles;"},{"loc":"2.4","t":"omne nemus cum fluviis,"},{"loc":"2.5","t":"omne canat profundum"},{"loc":"2.6","t":"Ligures favete campi,"},{"loc":"2.7","t":"Veneti favete montes,"},{"loc":"2.8","t":"subitisque se rosetis"},{"loc":"2.9","t":"vestiat Alpinus apex"},{"loc":"2.10","t":"et rubeant pruinae."},{"loc":"2.11","t":"Athesis strepat choreis"},{"loc":"2.12","t":"calamisque flexuosus"},{"loc":"2.13","t":"leve Mincius susurret"},{"loc":"2.14","t":"et Padus electriferis"},{"loc":"2.15","t":"admoduletur alnis;"},{"loc":"2.16","t":"epulisque iam repleto"},{"loc":"2.17","t":"resonet Quirite Thybris"},{"loc":"2.18","t":"dominique laeta votis"},{"loc":"2.19","t":"aurea septemgeminas"},{"loc":"2.20","t":"Roma coronet arces."},{"loc":"2.21","t":"Procul audiant Hiberi,"},{"loc":"2.22","t":"fluit unde semen aulae,"},{"loc":"2.23","t":"ubi plena laurearum"},{"loc":"2.24","t":"imperio feta domus"},{"loc":"2.25","t":"vix numeral triumphos."},{"loc":"2.26","t":"Habet hinc patrem maritus,"},{"loc":"2.27","t":"habet hinc puella matrem"},{"loc":"2.28","t":"geminaque parte ductum"},{"loc":"2.29","t":"Caesareum flumineo"},{"loc":"2.30","t":"stemma recurrit ortu."},{"loc":"2.31","t":"Decorent virecta Baetim,"},{"loc":"2.32","t":"Tagus intumescat auro"},{"loc":"2.33","t":"generisque procreator"},{"loc":"2.34","t":"sub vitreis Oceanus"},{"loc":"2.35","t":"luxurietur antris."},{"loc":"2.36","t":"Oriensque regna fratrum"},{"loc":"2.37","t":"simul Occidensque plaudat;"},{"loc":"2.38","t":"placide iocentur urbes,"},{"loc":"2.39","t":"quaeque novo quaeque nitent"},{"loc":"2.40","t":"deficiente Phoebo."},{"loc":"2.41","t":"Aquiloniae procellae,"},{"loc":"2.42","t":"rabidi tacete Cauri,"},{"loc":"2.43","t":"taceat sonorus Auster."},{"loc":"2.44","t":"Solus ovantem Zephyrus"},{"loc":"2.45","t":"perdominetur annum."},{"loc":"3.1","t":"Solitas galea fulgere comas,"},{"loc":"3.2","t":"Stilicho, molli necte corona,"},{"loc":"3.3","t":"cessent litui saevumque procul"},{"loc":"3.4","t":"Martem felix taeda releget."},{"loc":"3.5","t":"Tractus ab aula rursus in aulam"},{"loc":"3.6","t":"redeat sanguis, patris officiis"},{"loc":"3.7","t":"iunge potenti pignora dextra."},{"loc":"3.8","t":"Gener Augusti pridem fueras,"},{"loc":"3.9","t":"nunc rursus eris socer Augusti."},{"loc":"3.10","t":"Quae iam rabies livoris erit?"},{"loc":"3.11","t":"vel quis dabitur color invidiae?"},{"loc":"3.12","t":"Stilicho socer est, pater est Stilicho."},{"loc":"4.1","t":"Attollens thalamis Idalium iubar"},{"loc":"4.2","t":"dilectus Veneri nascitur Hesperus,"},{"loc":"4.3","t":"iam nuptae trepidat sollicitus pudor,"},{"loc":"4.4","t":"iam produnt lacrimas flammea simplices."},{"loc":"4.5","t":"Ne cessa, iuvenis, comminus adgredi,"},{"loc":"4.6","t":"impacata licet saeviat unguibus."},{"loc":"4.7","t":"Non quisquam fruitur veris odoribus"},{"loc":"4.8","t":"Hyblaeos latebris nec spoliat favos,"},{"loc":"4.9","t":"si fronti caveat, si timeat rubos;"},{"loc":"4.10","t":"armat spina rosas, mella tegunt apes."},{"loc":"4.11","t":"Crescunt difficili gaudia iurgio"},{"loc":"4.12","t":"accenditque magis, quae refugit, Venus,"},{"loc":"4.13","t":"quod flenti tuleris, plus sapit osculum."},{"loc":"4.14","t":"Dices o! quotiens, “hoc mihi dulcius"},{"loc":"4.15","t":"quam flavos deciens vincere Sarmatas!”"},{"loc":"4.16","t":"Adspirate novam pectoribus fidem"},{"loc":"4.17","t":"mansuramque facem tradite sensibus."},{"loc":"4.18","t":"Tam iunctis manibus nectite vincula,"},{"loc":"4.19","t":"quam frondens hedera stringitur aesculus,"},{"loc":"4.20","t":"quam lento premitur palmite populus,"},{"loc":"4.21","t":"et murmur querula blandius alite"},{"loc":"4.22","t":"Unguis adsiduo reddite mutuis."},{"loc":"4.23","t":"Et labris animum conciliantibus"},{"loc":"4.24","t":"alternum rapiat somnus anhelitum."},{"loc":"4.25","t":"Amplexu caleat purpura regio"},{"loc":"4.26","t":"et vestes Tyrio sanguine fulgidas"},{"loc":"4.27","t":"alter virgineus nobilitet cruor."},{"loc":"4.28","t":"Tum victor madido prosilias toro"},{"loc":"4.29","t":"nocturni referens vulnera proelii."},{"loc":"4.30","t":"Ducant pervigiles carmina tibiae"},{"loc":"4.31","t":"permissisque iocis turba licentior"},{"loc":"4.32","t":"exultet tetricis libera legibus."},{"loc":"4.33","t":"Passim cum ducibus ludite milites,"},{"loc":"4.34","t":"passim cum pueris ludite virgines."},{"loc":"4.35","t":"Haec vox aetheriis insonet axibus,"},{"loc":"4.36","t":"haec vox per populos, per mare transeat!"},{"loc":"4.37","t":"formosus Mariam ducit Honorius."}],"stats":{"units":135,"words":548}}