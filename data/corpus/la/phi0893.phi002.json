{"id":"phi0893.phi002","lang":"la","author":"Orazio","authorId":"phi0893","title":"Carme secolare","titleOrig":"Carmen Saeculare","titleState":"it","titleEn":"Carmen Saeculare","genre":"lirica","epoch":"augustea","inferred":true,"kind":"versi","source":{"urn":"urn:cts:latinLit:phi0893.phi002","repo":"canonical-latinLit","file":"phi0893.phi002.perseus-lat2.xml","edition":"Horace, Odes and Epodes. Shorey, Paul,editor; Laing, Gordon Jennings, joint editor. Chicago: B.H. Sanborn and Company, 1919.","license":"CC BY-SA (Perseus Digital Library)"},"citation":"libro.verso","units":[{"loc":"1.1","t":"Phoebe silvarumque potens Diana,"},{"loc":"1.2","t":"Lucidum caeli decus, o colendi"},{"loc":"1.3","t":"Semper et culti, date quae precamur"},{"loc":"1.4","t":"Tempore sacro,"},{"loc":"1.5","t":"Quo Sibyllini monuere versus"},{"loc":"1.6","t":"Virgines lectas puerosque castos"},{"loc":"1.7","t":"Dis quibus septem placuere colles"},{"loc":"1.8","t":"Dicere carmen."},{"loc":"1.9","t":"Alme Sol, curru nitido diem qui"},{"loc":"1.10","t":"Promis et celas aliusque et idem"},{"loc":"1.11","t":"Nasceris, possis nihil urbe Roma"},{"loc":"1.12","t":"Visere maius !"},{"loc":"1.13","t":"Rite maturos aperire partus"},{"loc":"1.14","t":"Lenis, Ilithyia, tuere matres,"},{"loc":"1.15","t":"Sive tu Lucina probas vocari"},{"loc":"1.16","t":"Seu Genitalis:"},{"loc":"1.17","t":"Diva, producas subolem patrumque"},{"loc":"1.18","t":"Prosperes decreta super iugandis"},{"loc":"1.19","t":"Feminis prolisque novae feraci"},{"loc":"1.20","t":"Lege marita,"},{"loc":"1.21","t":"Certus undenos deciens per annos"},{"loc":"1.22","t":"Orbis ut cantus referatque ludos"},{"loc":"1.23","t":"Ter die claro totiensque grata"},{"loc":"1.24","t":"Nocte frequentes."},{"loc":"1.25","t":"Vosque veraces cecinisse, Parcae,"},{"loc":"1.26","t":"Quod semel dictumst stabilisque rerum"},{"loc":"1.27","t":"Terminus servet, bona iam peractis"},{"loc":"1.28","t":"Iungite fata."},{"loc":"1.29","t":"Fertilis frugum pecorisque tellus"},{"loc":"1.30","t":"Spicea donet Cererem corona;"},{"loc":"1.31","t":"Nutriant fetus et aquae salubres"},{"loc":"1.32","t":"Et Iovis aurae."},{"loc":"1.33","t":"Condito mitis placidusque telo"},{"loc":"1.34","t":"Supplices audi pueros, Apollo;"},{"loc":"1.35","t":"Siderum regina bicornis, audi,"},{"loc":"1.36","t":"Luna, puellas:"},{"loc":"1.37","t":"Roma si vestrumst opus, Iliaeque"},{"loc":"1.38","t":"Litus Etruscum tenuere turmae,"},{"loc":"1.39","t":"Iussa pars mutare Lares et urbem"},{"loc":"1.40","t":"Sospite cursu,"},{"loc":"1.41","t":"Cui per ardentem sine fraude Troiam"},{"loc":"1.42","t":"Castus Aeneas patriae superstes"},{"loc":"1.43","t":"Liberum munivit iter, daturus"},{"loc":"1.44","t":"Plura relictis:"},{"loc":"1.45","t":"Di, probos mores docili iuventae,"},{"loc":"1.46","t":"Di, senectuti placidae quietem,"},{"loc":"1.47","t":"Romulae genti date remque prolemque"},{"loc":"1.48","t":"Et decus omne."},{"loc":"1.49","t":"Quaeque vos bobus veneratur albis"},{"loc":"1.50","t":"Clarus Anchisae Venerisque sanguis,"},{"loc":"1.51","t":"Impetret, bellante prior, iacentem"},{"loc":"1.52","t":"Lenis in hostem."},{"loc":"1.53","t":"iam mari terraque manus potentes"},{"loc":"1.54","t":"Medus Albanasque timet secures,"},{"loc":"1.55","t":"Iam Scythae responsa petunt superbi"},{"loc":"1.56","t":"Nuper, et Indi."},{"loc":"1.57","t":"Iam Fides et Pax et Honor Pudorque"},{"loc":"1.58","t":"Priscus et neglecta redire Virtus"},{"loc":"1.59","t":"Audet, adparetque beata pleno"},{"loc":"1.60","t":"Copia cornu."},{"loc":"1.61","t":"Augur et fulgente decorus arcu"},{"loc":"1.62","t":"Phoebus acceptusque novem Camenis,"},{"loc":"1.63","t":"Qui salutari levat arte fessos"},{"loc":"1.64","t":"Corporis artus,"},{"loc":"1.65","t":"Si Palatinas videt aequus arces,"},{"loc":"1.66","t":"Remque Romanam Latiumque felix"},{"loc":"1.67","t":"Alterum in lustrum meliusque semper"},{"loc":"1.68","t":"Prorogat aevum."},{"loc":"1.69","t":"Quaeque Aventinum tenet Algidumque,"},{"loc":"1.70","t":"Quindecim Diana preces virorum"},{"loc":"1.71","t":"Curat et votis puerorum amicas"},{"loc":"1.72","t":"Adplicat aures."},{"loc":"1.73","t":"Haec Iovem sentire deosque cunctos"},{"loc":"1.74","t":"Spem bonam certamque domum reporto,"},{"loc":"1.75","t":"Doctus et Phoebi chorus et Dianae"},{"loc":"1.76","t":"Dicere laudes."}],"stats":{"units":76,"words":310}}