{"id":"stoa0238.stoa009","lang":"la","author":"Prudenzio","authorId":"stoa0238","title":"Epilogus","titleOrig":null,"titleState":"orig","titleEn":"Epilogus","genre":"religione","epoch":"tarda","inferred":true,"year":405,"yearKind":"circa","yearNote":"chiude l'edizione complessiva aperta dalla Praefatio, che l'autore data al proprio cinq…","edition":"Thomson 1953","kind":"versi","source":{"urn":"urn:cts:latinLit:stoa0238.stoa009","repo":"canonical-latinLit","file":"stoa0238.stoa009.perseus-lat2.xml","edition":"Prudentius, Volume 2. Thomson, H. J, editor. London; Cambridge, Mass.: William Heinemann Ltd., Harvard University Press, 1953 (printing).","license":"CC BY-SA (Perseus Digital Library)"},"citation":"libro.verso","units":[{"loc":"1.1","t":"Inmolat Deo Patri"},{"loc":"1.2","t":"pius, fidelis, innocens, pudicus"},{"loc":"1.3","t":"dona conscientiae,"},{"loc":"1.4","t":"quibus beata mens abundat intus."},{"loc":"1.5","t":"Alter et pecuniam"},{"loc":"1.6","t":"recidit, unde victitent egeni."},{"loc":"1.7","t":"Nos citos iambicos"},{"loc":"1.8","t":"sacramus et rotatiles trochaeos"},{"loc":"1.9","t":"sanctitatis indigi"},{"loc":"1.10","t":"nec ad levamen pauperum potentes."},{"loc":"1.11","t":"Approbat tamen Deus"},{"loc":"1.12","t":"pedestre carmen et benignus audit."},{"loc":"1.13","t":"Multa divitis domo"},{"loc":"1.14","t":"sita est per omnes angulos supellex:"},{"loc":"1.15","t":"fulget aureus scyphus"},{"loc":"1.16","t":"nec aere defit expolita pelvis,"},{"loc":"1.17","t":"est et olla fictilis"},{"loc":"1.18","t":"gravisque et ampla argentea est parapsis,"},{"loc":"1.19","t":"sunt eburna quaepiam,"},{"loc":"1.20","t":"nonnulla quercu sunt cavata et ulmo."},{"loc":"1.21","t":"Omne vas fit utile"},{"loc":"1.22","t":"quod est ad usum congruens erilem;"},{"loc":"1.23","t":"instruunt enim domum"},{"loc":"1.24","t":"ut empta magno, sic parata ligno."},{"loc":"1.25","t":"Me paterno in atrio"},{"loc":"1.26","t":"ut obsoletum vasculum caducis"},{"loc":"1.27","t":"Christus aptat usibus"},{"loc":"1.28","t":"sinitque parte in anguli manere."},{"loc":"1.29","t":"Munus ecce fictile"},{"loc":"1.30","t":"inimus intra regiam salutis."},{"loc":"1.31","t":"Attamen vel infimam"},{"loc":"1.32","t":"Deo obsequellam praestitisse prodest."},{"loc":"1.33","t":"Quidquid illud accidit,"},{"loc":"1.34","t":"iuvabit ore personasse Christum. 1"}],"stats":{"units":34,"words":136}}