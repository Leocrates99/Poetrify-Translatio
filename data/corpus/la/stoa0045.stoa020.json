{"id":"stoa0045.stoa020","lang":"la","author":"Ausonio","authorId":"stoa0045","title":"Oratio versibus rhopalicis","titleOrig":null,"titleState":"orig","titleEn":"Oratio Versibus Rhopalicis","genre":"lirica","epoch":"tarda","inferred":true,"year":null,"yearKind":null,"yearNote":null,"kind":"versi","source":{"urn":"urn:cts:latinLit:stoa0045.stoa020","repo":"canonical-latinLit","file":"stoa0045.stoa020.perseus-lat2.xml","edition":"Ausonius, Decimus Magnus. Ausonius, Volume 1. Evelyn-White, Hugh G. (Hugh Gerard), editor. London, Cambridge, MA: William Heinemann, Ltd.; Harvard University Press, 1919.","license":"CC BY-SA (Perseus Digital Library)"},"citation":"libro.verso","units":[{"loc":"3.1","t":"Spes, deus, aeternae stationis conciliator:"},{"loc":"3.2","t":"si castis precibus veniales invigilamus,"},{"loc":"3.3","t":"his, pater, oratis placabilis adstipulare."},{"loc":"3.4","t":"Da, Christe, specimen cognoscier inreprehensum,"},{"loc":"3.5","t":"rex bone, cultorum famulantum vivificator."},{"loc":"3.6","t":"Cum patre maiestas altissima, non generate."},{"loc":"3.7","t":"Da trinum columen paraclito consociante,"},{"loc":"3.8","t":"ut longum celebris devotio continuetur:"},{"loc":"3.9","t":"ad temet properant vigilatum convenienter."},{"loc":"3.10","t":"Nox lucem revehet funalibus anteferendam,"},{"loc":"3.11","t":"nox lumen pariens credentibus indubitatum,"},{"loc":"3.12","t":"nox flammis operum meditatrix sidereorum."},{"loc":"3.13","t":"Tu mensis dirimis ieiunia relligiosa,"},{"loc":"3.14","t":"tu bona promittens surgentia concelebraris:"},{"loc":"3.15","t":"da, rector, modicos effarier omnipotentem."},{"loc":"3.16","t":"Fons tuus emundat recreatu iustificatos,"},{"loc":"3.17","t":"dans mentem oblitam positorum flagitiorum,"},{"loc":"3.18","t":"dans agnos niveos splendescere purificatos."},{"loc":"3.21","t":"Lux verbo inducta, peccantibus auxiliatrix,"},{"loc":"3.19","t":"ut nova Iordanis ablutio, sanctificavit,"},{"loc":"3.20","t":"cum sua dignati tinguentia promeruerunt."},{"loc":"3.22","t":"Et Christus regimen elementis inrequietis"},{"loc":"3.23","t":"fert undam medici baptismatis intemerati,"},{"loc":"3.24","t":"ut noxam auferret mortalibus extenuatam."},{"loc":"3.25","t":"Crux poenae extremum properata inmaculato,"},{"loc":"3.26","t":"ut vitam amissam renovaret mortificatus,"},{"loc":"3.28","t":"tot rerum titulis obnoxius immodicarum."},{"loc":"3.27","t":"Quis digne domino praeconia continuabit?"},{"loc":"3.29","t":"an terra humano locupletat commemoratu,"},{"loc":"3.30","t":"quem vocum resonant modulatus angelicarum?"},{"loc":"3.31","t":"Dans aulam Stephano pretiosam dilapidato,"},{"loc":"3.32","t":"dans claves superas cathedrali incohatori,"},{"loc":"3.33","t":"quin Paulum infestum copulasti adglomeratu."},{"loc":"3.34","t":"Fit doctor populi lapidantum constimulator,"},{"loc":"3.35","t":"ut latro confessor paradisum participavit,"},{"loc":"3.36","t":"sic, credo, adnectens dirissima clarificandis."},{"loc":"3.37","t":"Nos seros famulos adcrescere perpetieris"},{"loc":"3.38","t":"sub tali edoctos antistite relligionis;"},{"loc":"3.39","t":"da sensum solida stabilitum credulitate."},{"loc":"3.40","t":"Fac iungar numero redivivo glorificatus,"},{"loc":"3.41","t":"ad- caelum invitans consortia terrigenarum,"},{"loc":"3.42","t":"SPES, DEUS, AETERNAE STATIONIS CONCILIATOR!"}],"stats":{"units":42,"words":211}}