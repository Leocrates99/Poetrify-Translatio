{"id":"phi0893.phi003","lang":"la","author":"Orazio","authorId":"phi0893","title":"Epodi","titleOrig":"Epodon","titleState":"it","titleEn":"Epodi","genre":"lirica","epoch":"augustea","inferred":true,"year":-30,"yearKind":"circa","yearNote":"raccolta pubblicata ca. 30 a.C.: l'epodo 9 presuppone Azio (31) e l'epodo 16 la guerra …","edition":"Vollmer 1912","kind":"versi","source":{"urn":"urn:cts:latinLit:phi0893.phi003","repo":"canonical-latinLit","file":"phi0893.phi003.perseus-lat2.xml","edition":"Horace. Q. Horati Flacci Carmina. Vollmer, Friedrich, editor. Leipzig: Teubner, 1912.","license":"CC BY-SA (Perseus Digital Library)"},"citation":"libro.verso","units":[{"loc":"1.1","t":"Ibis Liburnis inter alta navium,"},{"loc":"1.2","t":"amice, propugnacula,"},{"loc":"1.3","t":"paratus omne Caesaris periculum"},{"loc":"1.4","t":"subire, Maecenas, tuo:"},{"loc":"1.5","t":"quid nos, quibus te vita sit superstite"},{"loc":"1.6","t":"iucunda, si contra, gravis?"},{"loc":"1.7","t":"utrumne iussi persequemur otium"},{"loc":"1.8","t":"non dulce, ni tecum simul,"},{"loc":"1.9","t":"an hunc laborem mente laturi, decet"},{"loc":"1.10","t":"qua ferre non mollis viros?"},{"loc":"1.11","t":"feremus et te vel per Alpium iuga"},{"loc":"1.12","t":"inhospitalem et Caucasum"},{"loc":"1.13","t":"vel occidentis usque ad ultimum sinum"},{"loc":"1.14","t":"forti sequemur pectore."},{"loc":"1.15","t":"Roges, tuom labore quid iuvem meo,"},{"loc":"1.16","t":"inbellis ac firmus parum?"},{"loc":"1.17","t":"comes minore sum futurus in metu,"},{"loc":"1.18","t":"qui maior absentis habet:"},{"loc":"1.19","t":"ut adsidens inplumibus pullis avis"},{"loc":"1.20","t":"serpentium adlapsus timet"},{"loc":"1.21","t":"magis relictis, non, ut adsit, auxili"},{"loc":"1.22","t":"latura plus praesentibus."},{"loc":"1.23","t":"Libenter hoc et omne militabitur"},{"loc":"1.24","t":"bellum in tuae spem gratiae,"},{"loc":"1.25","t":"non ut iuvencis inligata pluribus"},{"loc":"1.26","t":"aratra nitantur meis"},{"loc":"1.27","t":"pecusve Calabris ante Sidus fervidum"},{"loc":"1.28","t":"Lucana mutet pascuis"},{"loc":"1.29","t":"neque ut superni villa candens Tusculi"},{"loc":"1.30","t":"Circaea tangat moenia:"},{"loc":"1.31","t":"satis superque me benignitas tua"},{"loc":"1.32","t":"ditavit, haud paravero"},{"loc":"1.33","t":"quod aut avarus ut Chremes terra premam,"},{"loc":"1.34","t":"discinctus aut perdam nepos."},{"loc":"2.1","t":"“Beatus ille qui procul negotiis,"},{"loc":"2.2","t":"ut prisca gens mortalium,"},{"loc":"2.3","t":"paterna rura bubus exercet suis"},{"loc":"2.4","t":"solutus omni faenore"},{"loc":"2.5","t":"neque excitatur classico miles truci"},{"loc":"2.6","t":"neque horret iratum mare"},{"loc":"2.7","t":"forumque vitat et superba civium"},{"loc":"2.8","t":"potentiorum limina."},{"loc":"2.9","t":"Ergo aut adulta vitium propagine"},{"loc":"2.10","t":"altas maritat populos"},{"loc":"2.11","t":"aut in reducta valle mugientium"},{"loc":"2.12","t":"prospectat errantis greges"},{"loc":"2.13","t":"inutilisque falce ramos amputans"},{"loc":"2.14","t":"feliciores inserit"},{"loc":"2.15","t":"aut pressa puris mella condit amphoris"},{"loc":"2.16","t":"aut tondet infirmas ovis."},{"loc":"2.17","t":"Vel cum decorum mitibus pomis caput"},{"loc":"2.18","t":"Autumnus agris extulit,"},{"loc":"2.19","t":"ut gaudet insitiva decerpens pira"},{"loc":"2.20","t":"certantem et uvam purpurae,"},{"loc":"2.21","t":"qua muneretur te, Priape, et te, pater"},{"loc":"2.22","t":"Silvane, tutor finium."},{"loc":"2.23","t":"Libet iacere modo sub antiqua ilice,"},{"loc":"2.24","t":"modo in tenaci gramine:"},{"loc":"2.25","t":"labuntur altis interim ripis aquae,"},{"loc":"2.26","t":"queruntur in Silvis aves"},{"loc":"2.27","t":"frondesque lymphis obstrepunt manantibus,"},{"loc":"2.28","t":"somnos quod invitet levis."},{"loc":"2.29","t":"At cum tonantis annus hibernus Iovis"},{"loc":"2.30","t":"imbris nivisque conparat,"},{"loc":"2.31","t":"aut trudit acris hinc et hinc multa cane"},{"loc":"2.32","t":"apros in obstantis plagas"},{"loc":"2.33","t":"aut amite levi rara tendit retia"},{"loc":"2.34","t":"turdis edacibus dolos"},{"loc":"2.35","t":"pavidumque leporem et advenam laqueo gruem"},{"loc":"2.36","t":"iucunda captat praemia."},{"loc":"2.37","t":"Quis non malarum quas amor curas habet"},{"loc":"2.38","t":"haec inter obliviscitur?"},{"loc":"2.39","t":"quodsi pudica mulier in partem iuvet"},{"loc":"2.40","t":"domum atque dulcis liberos,"},{"loc":"2.41","t":"Sabina qualis aut perusta Solibus"},{"loc":"2.42","t":"pernicis uxor Apuli,"},{"loc":"2.43","t":"sacrum vetustis exstruat lignis focum"},{"loc":"2.44","t":"lassi Sub adventum viri"},{"loc":"2.45","t":"claudensque textis cratibus laetum pecus"},{"loc":"2.46","t":"distenta siccet ubera"},{"loc":"2.47","t":"et horna dulci vina promens dolio"},{"loc":"2.48","t":"dapes inemptas adparet:"},{"loc":"2.49","t":"non me Lucrina iuverint conchylia"},{"loc":"2.50","t":"magisve rhombus aut scari,"},{"loc":"2.51","t":"siquos Eois intonata fluctibus"},{"loc":"2.52","t":"hiems ad hoc vertat mare,"},{"loc":"2.53","t":"non Afra avis descendat in ventrem meum,"},{"loc":"2.54","t":"non attagen Ionicus"},{"loc":"2.55","t":"iucundior quam lecta de pinguissimis"},{"loc":"2.56","t":"oliva ramis arborum"},{"loc":"2.57","t":"aut herba lapathi prata amantis et gravi"},{"loc":"2.58","t":"malvae salubres corpori"},{"loc":"2.59","t":"vel agna festis caesa Terminalibus"},{"loc":"2.60","t":"vel haedus ereptus lupo."},{"loc":"2.61","t":"Has inter epulas ut iuvat pastas ovis"},{"loc":"2.62","t":"videre properantis domum,"},{"loc":"2.63","t":"videre fessos vomerem inversum boves"},{"loc":"2.64","t":"collo trahentis languido"},{"loc":"2.65","t":"positosque vernas, ditis examen domus,"},{"loc":"2.66","t":"circum renidentis Laris.”"},{"loc":"2.67","t":"haec ubi locutus faenerator Alfius,"},{"loc":"2.68","t":"iam iam futurus rusticus,"},{"loc":"2.69","t":"omnem redegit idibus pecuniam,"},{"loc":"2.70","t":"quaerit kalendis ponere."},{"loc":"3.1","t":"Parentis olim siquis inpia manu"},{"loc":"3.2","t":"senile guttur fregerit,"},{"loc":"3.3","t":"edit cicutis alium nocentius."},{"loc":"3.4","t":"O dura messorum ilia."},{"loc":"3.5","t":"Quid hoc veneni saevit in praecordiis?"},{"loc":"3.6","t":"num viperinus his cruor"},{"loc":"3.7","t":"incoctus herbis me fefellit? an malas"},{"loc":"3.8","t":"Canidia tractavit dapes?"},{"loc":"3.9","t":"ut Argonautas praeter omnis candidum"},{"loc":"3.10","t":"Medea mirata est ducem,"},{"loc":"3.11","t":"ignota tauris inligaturum iuga"},{"loc":"3.12","t":"perunxit hoc Iasonem,"},{"loc":"3.13","t":"hoc delibutis ulta donis paelicem"},{"loc":"3.14","t":"serpente fugit alite."},{"loc":"3.15","t":"Nec tantus umquam Siderum insedit vapor"},{"loc":"3.16","t":"siticulosae Apuliae"},{"loc":"3.17","t":"nec munus umeris efficacis Herculis"},{"loc":"3.18","t":"inarsit aestuosius."},{"loc":"3.19","t":"At siquid umquam tale concupiveris,"},{"loc":"3.20","t":"iocose Maecenas, precor,"},{"loc":"3.21","t":"manum puella savio opponat tuo,"},{"loc":"3.22","t":"extrema et in sponda cubet."},{"loc":"4.1","t":"Lupis et agnis quanta Sortito obtigit,"},{"loc":"4.2","t":"tecum mihi discordia est,"},{"loc":"4.3","t":"Hibericis peruste funibus latus"},{"loc":"4.4","t":"et crura dura compede."},{"loc":"4.5","t":"Licet superbus ambules pecunia,"},{"loc":"4.6","t":"fortuna non mutat genus."},{"loc":"4.7","t":"Videsne, sacram metiente te viam"},{"loc":"4.8","t":"cum bis trium ulnarum toga,"},{"loc":"4.9","t":"ut ora vertat huc et huc euntium"},{"loc":"4.10","t":"liberrima indignatio?"},{"loc":"4.11","t":"“sectus flagellis hic triumviralibus"},{"loc":"4.12","t":"praeconis ad fastidium"},{"loc":"4.13","t":"arat Falerni mille fundi iugera"},{"loc":"4.14","t":"et Appiam mannis terit"},{"loc":"4.15","t":"sedilibusque magnus in primis eques"},{"loc":"4.16","t":"Othone contempto sedet."},{"loc":"4.17","t":"Quid attinet tot ora navium gravi"},{"loc":"4.18","t":"rostrata duci pondere"},{"loc":"4.19","t":"contra latrones atque servilem manum"},{"loc":"4.20","t":"hoc, hoc tribuno militum?”"},{"loc":"5.1","t":"“At o deorum quidquid in caelo regit"},{"loc":"5.2","t":"terras et humanum genus,"},{"loc":"5.3","t":"quid iste fert tumultus aut quid omnium"},{"loc":"5.4","t":"voltus in unum me truces?"},{"loc":"5.5","t":"per liberos te, si vocata partubus"},{"loc":"5.6","t":"Lucina veris adfuit,"},{"loc":"5.7","t":"per hoc inane purpurae decus precor,"},{"loc":"5.8","t":"per inprobaturum haec Iovem,"},{"loc":"5.9","t":"quid ut noverca me intueris aut uti"},{"loc":"5.10","t":"petita ferro belua?”"},{"loc":"5.11","t":"ut haec trementi questus ore constitit"},{"loc":"5.12","t":"insignibus raptis puer,"},{"loc":"5.13","t":"inpube corpus, quale posset inpia"},{"loc":"5.14","t":"mollire Thracum pectora:"},{"loc":"5.15","t":"Canidia, brevibus illigata viperis"},{"loc":"5.16","t":"crinis et incomptum caput,"},{"loc":"5.17","t":"iubet sepulcris caprificos erutas,"},{"loc":"5.18","t":"iubet cupressos funebris"},{"loc":"5.19","t":"et uncta turpis ova ranae Sanguine"},{"loc":"5.20","t":"plumamque nocturnae strigis"},{"loc":"5.21","t":"herbasque, quas Iolcos atque Hiberia"},{"loc":"5.22","t":"mittit venenorum ferax,"},{"loc":"5.23","t":"et ossa ab ore rapta ieiunae canis"},{"loc":"5.24","t":"flammis aduri Colchicis."},{"loc":"5.25","t":"At expedita Sagana, per totam domum"},{"loc":"5.26","t":"spargens Avernalis aquas,"},{"loc":"5.27","t":"horret capillis ut marinus asperis"},{"loc":"5.28","t":"echinus aut Laurens aper."},{"loc":"5.29","t":"Abacta nulla Veia conscientia"},{"loc":"5.30","t":"ligonibus duris humum"},{"loc":"5.31","t":"exhauriebat, ingemens laboribus,"},{"loc":"5.32","t":"quo posset infossus puer"},{"loc":"5.33","t":"longo die bis terque mutatae dapis"},{"loc":"5.34","t":"inemori spectaculo,"},{"loc":"5.35","t":"cum promineret ore, quantum exstant aqua"},{"loc":"5.36","t":"suspensa mento corpora;"},{"loc":"5.37","t":"exsucta uti medulla et aridum iecur"},{"loc":"5.38","t":"amoris esset poculum,"},{"loc":"5.39","t":"interminato cum semel fixae cibo"},{"loc":"5.40","t":"intabuissent pupulae."},{"loc":"5.41","t":"Non defuisse masculae libidinis"},{"loc":"5.42","t":"Ariminensem Foliam"},{"loc":"5.43","t":"et otiosa credidit Neapolis"},{"loc":"5.44","t":"et omne vicinum oppidum,"},{"loc":"5.45","t":"quae sidera excantata voce Thessala"},{"loc":"5.46","t":"lunamque caelo deripit."},{"loc":"5.47","t":"Hic inresectum saeva dente livido"},{"loc":"5.48","t":"Canidia rodens pollicem"},{"loc":"5.49","t":"quid dixit aut quid tacuit? “o rebus meis"},{"loc":"5.50","t":"non infideles arbitrae,"},{"loc":"5.51","t":"Nox et Diana, quae silentium regis,"},{"loc":"5.52","t":"arcana cum fiunt sacra,"},{"loc":"5.53","t":"nunc, nunc adeste, nunc in hostilis domos"},{"loc":"5.54","t":"iram atque numen vertite."},{"loc":"5.55","t":"Formidulosis cum latent silvis ferae"},{"loc":"5.56","t":"dulci sopore languidae,"},{"loc":"5.57","t":"senem, quod omnes rideant, adulterum"},{"loc":"5.58","t":"latrent Suburanae canes"},{"loc":"5.59","t":"nardo perunctum, quale non perfectius"},{"loc":"5.60","t":"meae laborarint manus."},{"loc":"5.61","t":"Quid accidit? cur dira barbarae minus"},{"loc":"5.62","t":"venena Medeae valent,"},{"loc":"5.63","t":"quibus Superbam fugit ulta paelicem,"},{"loc":"5.64","t":"magni Creontis filiam,"},{"loc":"5.65","t":"cum palla, tabo munus imbutum, novam"},{"loc":"5.66","t":"incendio nuptam abstulit?"},{"loc":"5.67","t":"atqui nec herba nec latens in asperis"},{"loc":"5.68","t":"radix fefellit me locis."},{"loc":"5.69","t":"Indormit unctis omnium cubilibus"},{"loc":"5.70","t":"oblivione paelicum?"},{"loc":"5.71","t":"a, a, solutus ambulat veneficae"},{"loc":"5.72","t":"scientioris carmine."},{"loc":"5.73","t":"Non usitatis, Vare, potionibus,"},{"loc":"5.74","t":"o multa fleturum caput,"},{"loc":"5.75","t":"ad me recurres nec vocata mens tua"},{"loc":"5.76","t":"Marsis redibit vocibus."},{"loc":"5.77","t":"Maius parabo, maius infundam tibi"},{"loc":"5.78","t":"fastidienti poculum"},{"loc":"5.79","t":"priusque caelum Sidet inferius mari"},{"loc":"5.80","t":"tellure porrecta super"},{"loc":"5.81","t":"quam non amore sic meo flagres uti"},{"loc":"5.82","t":"bitumen atris ignibus.”"},{"loc":"5.83","t":"sub haec puer iam non, ut ante, mollibus"},{"loc":"5.84","t":"lenire verbis inpias,"},{"loc":"5.85","t":"sed dubius unde rumperet silentium,"},{"loc":"5.86","t":"misit Thyesteas preces:"},{"loc":"5.87","t":"“venena maga non fas nefasque, non valent"},{"loc":"5.88","t":"convertere humanam vicem."},{"loc":"5.89","t":"Diris agam vos: dira detestatio"},{"loc":"5.90","t":"nulla expiatur victima."},{"loc":"5.91","t":"Quin, ubi perire iussus exspiravero,"},{"loc":"5.92","t":"nocturnus occurram Furor"},{"loc":"5.93","t":"petamque voltus umbra curvis unguibus,"},{"loc":"5.94","t":"quae vis deorum est Manium,"},{"loc":"5.95","t":"et inquietis adsidens praecordiis"},{"loc":"5.96","t":"pavore somnos auferam."},{"loc":"5.97","t":"Vos turba vicatim hinc et hinc saxis petens"},{"loc":"5.98","t":"contundet obscaenas anus;"},{"loc":"5.99","t":"post insepulta membra different lupi"},{"loc":"5.100","t":"et Esquilinae alites"},{"loc":"5.101","t":"neque hoc parentes, heu mihi superstites,"},{"loc":"5.102","t":"effugerit spectaculum.”"},{"loc":"6.1","t":"Quid inmerentis hospites vexas, canis"},{"loc":"6.2","t":"ignavos adversum lupos?"},{"loc":"6.3","t":"quin huc inanis, si potes, vertis minas"},{"loc":"6.4","t":"et me remorsurum petis?"},{"loc":"6.5","t":"nam qualis aut Molossus aut fulvos Lacon,"},{"loc":"6.6","t":"amica vis pastoribus,"},{"loc":"6.7","t":"agam per altas aure sublata nivis"},{"loc":"6.8","t":"quaecumque praecedet fera;"},{"loc":"6.9","t":"tu, cum timenda voce complesti nemus,"},{"loc":"6.10","t":"proiectum odoraris cibum."},{"loc":"6.11","t":"Cave, cave, namque in malos asperrimus"},{"loc":"6.12","t":"parata tollo cornua,"},{"loc":"6.13","t":"qualis Lycambae spretus infido gener"},{"loc":"6.14","t":"aut acer hostis Bupalo."},{"loc":"6.15","t":"An si quis atro dente me petiverit,"},{"loc":"6.16","t":"inultus ut flebo puer?"},{"loc":"7.1","t":"Quo, quo scelesti ruitis? aut cur dexteris"},{"loc":"7.2","t":"aptantur enses conditi?"},{"loc":"7.3","t":"parumne campis atque Neptuno super"},{"loc":"7.4","t":"fusum est Latini sanguinis,"},{"loc":"7.5","t":"non ut superbas invidae Karthaginis"},{"loc":"7.6","t":"Romanus arces ureret,"},{"loc":"7.7","t":"intactus aut Britannus ut descenderet"},{"loc":"7.8","t":"sacra catenatus via,"},{"loc":"7.9","t":"sed ut Secundum vota Parthorum sua"},{"loc":"7.10","t":"Vrbs haec periret dextera?"},{"loc":"7.11","t":"neque hic lupis mos nec fuit leonibus"},{"loc":"7.12","t":"umquam nisi in dispar feris."},{"loc":"7.13","t":"Furorne caecos an rapit vis acrior"},{"loc":"7.14","t":"an culpa? responsum date."},{"loc":"7.15","t":"Tacent et albus ora pallor inficit"},{"loc":"7.16","t":"mentesque perculsae Stupent."},{"loc":"7.17","t":"Sic est: acerba fata Romanos agunt"},{"loc":"7.18","t":"scelusque fraternae necis,"},{"loc":"7.19","t":"ut inmerentis fluxit in terram Remi"},{"loc":"7.20","t":"sacer nepotibus cruor."},{"loc":"8.1","t":"Rogare longo putidam te saeculo,"},{"loc":"8.2","t":"viris quid enervet meas,"},{"loc":"8.3","t":"cum sit tibi dens ater et rugis vetus"},{"loc":"8.4","t":"frontem senectus exaret"},{"loc":"8.5","t":"hietque turpis inter aridas natis"},{"loc":"8.6","t":"podex velut crudae bovis."},{"loc":"8.7","t":"Sed incitat me pectus et mammae putres"},{"loc":"8.8","t":"equina quales ubera"},{"loc":"8.9","t":"venterque mollis et femur tumentibus"},{"loc":"8.10","t":"exile suris additum."},{"loc":"8.11","t":"Esto beata, funus atque imagines"},{"loc":"8.12","t":"ducant triumphales tuom"},{"loc":"8.13","t":"nec sit marita, quae rotundioribus"},{"loc":"8.14","t":"onusta bacis ambulet."},{"loc":"8.15","t":"Quid? quod libelli Stoici inter Sericos"},{"loc":"8.16","t":"iacere pulvillos amant,"},{"loc":"8.17","t":"inlitterati num minus nervi rigent"},{"loc":"8.18","t":"minusve languet fascinum?"},{"loc":"8.19","t":"quod ut superbo provoces ab inguine,"},{"loc":"8.20","t":"ore adlaborandum est tibi."},{"loc":"9.1","t":"Quando repositum Caecubum ad festas dapes"},{"loc":"9.2","t":"victore laetus Caesare"},{"loc":"9.3","t":"tecum sub alta—sic Iovi gratum—domo,"},{"loc":"9.4","t":"beate Maecenas, bibam"},{"loc":"9.5","t":"sonante mixtum tibiis carmen lyra,"},{"loc":"9.6","t":"hac Dorium, illis barbarum?"},{"loc":"9.7","t":"ut nuper, actus cum freto Neptunius"},{"loc":"9.8","t":"dux fugit ustis navibus"},{"loc":"9.9","t":"minatus Vrbi vincla, quae detraxerat"},{"loc":"9.10","t":"servis amicus perfidis."},{"loc":"9.11","t":"Romanus eheu—posteri negabitis—"},{"loc":"9.12","t":"emancipatus feminae"},{"loc":"9.13","t":"fert vallum et arma miles et spadonibus"},{"loc":"9.14","t":"servire rugosis potest"},{"loc":"9.15","t":"interque signa turpe militaria"},{"loc":"9.16","t":"sol adspicit conopium."},{"loc":"9.17","t":"Ad hunc frementis verterunt bis mille equos"},{"loc":"9.18","t":"Galli canentes Caesarem"},{"loc":"9.19","t":"hostiliumque navium portu latent"},{"loc":"9.20","t":"puppes sinistrorsum citae."},{"loc":"9.21","t":"Io Triumphe, tu moraris aureos"},{"loc":"9.22","t":"currus et intactas boves?"},{"loc":"9.23","t":"io Triumphe, nec Iugurthino parem"},{"loc":"9.24","t":"bello reportasti ducem"},{"loc":"9.25","t":"neque Africanum, cui super Karthaginem"},{"loc":"9.26","t":"virtus Sepulcrum condidit."},{"loc":"9.27","t":"Terra marique victus hostis Punico"},{"loc":"9.28","t":"lugubre mutavit sagum."},{"loc":"9.29","t":"Aut ille centum nobilem Cretam urbibus"},{"loc":"9.30","t":"ventis iturus non suis"},{"loc":"9.31","t":"exercitatas aut petit Syrtis noto"},{"loc":"9.32","t":"aut fertur incerto mari."},{"loc":"9.33","t":"Capaciores adfer huc, puer, Scyphos"},{"loc":"9.34","t":"et Chia vina aut Lesbia"},{"loc":"9.35","t":"vel quod fluentem nauseam coerceat"},{"loc":"9.36","t":"metire nobis Caecubum."},{"loc":"9.37","t":"Curam metumque Caesaris rerum iuvat"},{"loc":"9.38","t":"dulci Lyaeo solvere."},{"loc":"10.1","t":"Mala soluta navis exit alite"},{"loc":"10.2","t":"ferens olentem Mevium."},{"loc":"10.3","t":"Ut horridis utrumque verberes latus,"},{"loc":"10.4","t":"Auster, memento fluctibus;"},{"loc":"10.5","t":"niger rudentis Eurus inverso mari"},{"loc":"10.6","t":"fractosque remos differat;"},{"loc":"10.7","t":"insurgat Aquilo, quantus altis montibus"},{"loc":"10.8","t":"frangit trementis ilics;"},{"loc":"10.9","t":"nec sidus atra nocte amicum adpareat,"},{"loc":"10.10","t":"qua tristis Orion cadit;"},{"loc":"10.11","t":"quietiore nec feratur aequore"},{"loc":"10.12","t":"quam Graia victorum manus,"},{"loc":"10.13","t":"cum Pallas usto vertit iram ab Ilio"},{"loc":"10.14","t":"in inpiam Aiacis ratem."},{"loc":"10.15","t":"O quantus instat navitis sudor tuis"},{"loc":"10.16","t":"tibique pallor luteus"},{"loc":"10.17","t":"et illa non virilis heiulatio"},{"loc":"10.18","t":"preces et aversum ad Iovem,"},{"loc":"10.19","t":"Ionius udo cum remugiens sinus"},{"loc":"10.20","t":"Noto carinam ruperit"},{"loc":"10.21","t":"opima quodsi praeda curvo litore"},{"loc":"10.22","t":"porrecta mergos iuverit,"},{"loc":"10.23","t":"libidinosus immolabitur caper"},{"loc":"10.24","t":"et agna Tempestatibus."},{"loc":"11.1","t":"Petti, nihil me sicut antea iuvat"},{"loc":"11.2","t":"scribere versiculos amore percussum gravi,"},{"loc":"11.3","t":"amore, qui me praeter omnis expetit"},{"loc":"11.4","t":"mollibus in pueris aut in puellis urere."},{"loc":"11.5","t":"Hic tertius December, ex quo destiti"},{"loc":"11.6","t":"Inachia furere, silvis honorem decutit."},{"loc":"11.7","t":"Heu me, per Vrbem (nam pudet tanti mali)"},{"loc":"11.8","t":"fabula quanta fui, conviviorum et paenitet,"},{"loc":"11.9","t":"in quis amantem languor et silentium"},{"loc":"11.10","t":"arguit et latere petitus imo spiritus."},{"loc":"11.11","t":"“contrane lucrum nil valere candidum"},{"loc":"11.12","t":"pauperis ingenium” querebar adplorans tibi,"},{"loc":"11.13","t":"simul calentis inverecundus deus"},{"loc":"11.14","t":"fervidiore mero arcana promorat loco."},{"loc":"11.15","t":"“quodsi meis inaestuet praecordiis"},{"loc":"11.16","t":"libera bilis, ut haec ingrata ventis dividat"},{"loc":"11.17","t":"fomenta volnus nil malum levantia,"},{"loc":"11.18","t":"desinet inparibus certare submotus pudor.”"},{"loc":"11.19","t":"ubi haec severus te palam laudaveram,"},{"loc":"11.20","t":"iussus abire domum ferebar incerto pede"},{"loc":"11.21","t":"ad non amicos heu mihi postis et heu"},{"loc":"11.22","t":"limina dura, quibus lumbos et infregi latus."},{"loc":"11.23","t":"Nunc gloriantis quamlibet mulierculam"},{"loc":"11.24","t":"vincere mollitia amor Lycisci me tenet;"},{"loc":"11.25","t":"unde expedire non amicorum queant"},{"loc":"11.26","t":"libera consilia nec contumeliae graves,"},{"loc":"11.27","t":"sed alius ardor aut puellae candidae"},{"loc":"11.28","t":"aut teretis pueri longam renodantis comam."},{"loc":"12.1","t":"Quid tibi vis, mulier nigris dignissima barris?"},{"loc":"12.2","t":"munera quid mihi quidve tabellas"},{"loc":"12.3","t":"mittis nec firmo iuveni neque naris obesae?"},{"loc":"12.4","t":"namque sagacius unus odoror,"},{"loc":"12.5","t":"polypus an gravis hirsutis cubet hircus in alis"},{"loc":"12.6","t":"quam canis acer ubi lateat sus."},{"loc":"12.7","t":"Qui sudor vietis et quam malus undique membris"},{"loc":"12.8","t":"crescit odor, cum pene Soluto"},{"loc":"12.9","t":"indomitam properat rabiem sedare, neque illi"},{"loc":"12.10","t":"iam manet umida creta colorque"},{"loc":"12.11","t":"stercore fucatus crocodili iamque Subando"},{"loc":"12.12","t":"tenta cubilia tectaque rumpit."},{"loc":"12.13","t":"Vel mea cum saevis agitat fastidia verbis:"},{"loc":"12.14","t":"“Inachia langues minus ac me;"},{"loc":"12.15","t":"Inachiam ter nocte potes, mihi Semper ad unum"},{"loc":"12.16","t":"mollis opus. Pereat male quae te"},{"loc":"12.17","t":"Lesbia quaerenti taurum monstravit inertem."},{"loc":"12.18","t":"Cum mihi Cous adesset Amyntas,"},{"loc":"12.19","t":"cuius in indomito constantior inguine nervos"},{"loc":"12.20","t":"quam nova collibus arbor inhaeret."},{"loc":"12.21","t":"Muricibus Tyriis iteratae vellera lanae"},{"loc":"12.22","t":"cui properabantur? tibi nempe,"},{"loc":"12.23","t":"ne foret aequalis inter conviva, magis quem"},{"loc":"12.24","t":"diligeret mulier sua quam te."},{"loc":"12.25","t":"O ego non felix, quam tu fugis, ut pavet acris"},{"loc":"12.26","t":"agna lupos capreaeque leones!”"},{"loc":"13.1","t":"Horrida tempestas caelum contraxit et imbres"},{"loc":"13.2","t":"nivesque deducunt Iovem; nunc mare, nunc siluae"},{"loc":"13.3","t":"Threicio Aquilone sonant. Rapiamus, amici,"},{"loc":"13.4","t":"Occasionem de die dumque virent genua"},{"loc":"13.5","t":"et decet, obducta solvatur fronte senectus."},{"loc":"13.6","t":"Tu vina Torquato move consule pressa meo."},{"loc":"13.7","t":"Cetera mitte loqui: deus haec fortasse benigna"},{"loc":"13.8","t":"reducet in sedem vice. Nunc et Achaemenio"},{"loc":"13.9","t":"perfundi nardo iuvat et fide Cyllenea"},{"loc":"13.10","t":"levare diris pectora Sollicitudinibus,"},{"loc":"13.11","t":"nobilis ut grandi cecinit Centaurus alumno:"},{"loc":"13.12","t":"“invicte, mortalis dea nate puer Thetide,"},{"loc":"13.13","t":"te manet Assaraci tellus, quam frigida parvi"},{"loc":"13.14","t":"findunt Scamandri flumina lubricus et Simois,"},{"loc":"13.15","t":"unde tibi reditum certo Subtemine Parcae"},{"loc":"13.16","t":"rupere, nec mater domum caerula te revehet."},{"loc":"13.17","t":"Illic omne malum vino cantuque levato,"},{"loc":"13.18","t":"deformis aegrimoniae dulcibus adloquiis.”"},{"loc":"14.1","t":"Mollis inertia cur tantam diffuderit imis"},{"loc":"14.2","t":"oblivionem sensibus,"},{"loc":"14.3","t":"pocula Lethaeos ut si ducentia somnos"},{"loc":"14.4","t":"arente fauce traxerim,"},{"loc":"14.5","t":"candide Maecenas, occidis Saepe rogando:"},{"loc":"14.6","t":"deus, deus nam me vetat"},{"loc":"14.7","t":"inceptos, olim promissum carmen, iambos"},{"loc":"14.8","t":"ad umbilicum adducere."},{"loc":"14.9","t":"Non aliter Samio dicunt arsisse Bathyllo"},{"loc":"14.10","t":"Anacreonta Teium,"},{"loc":"14.11","t":"qui persaepe cava testudine flevit amorem"},{"loc":"14.12","t":"non elaboratum ad pedem."},{"loc":"14.13","t":"Ureris ipse miser: quodsi non pulcrior ignis"},{"loc":"14.14","t":"accendit obsessam Ilion,"},{"loc":"14.15","t":"gaude sorte tua; me libertina, nec uno"},{"loc":"14.16","t":"contenta, Phryne macerat."},{"loc":"15.1","t":"Nox erat et caelo fulgebat Luna sereno"},{"loc":"15.2","t":"inter minora sidera,"},{"loc":"15.3","t":"cum tu, magnorum numen laesura deorum,"},{"loc":"15.4","t":"in verba iurabas mea,"},{"loc":"15.5","t":"artius atque hedera procera adstringitur ilex"},{"loc":"15.6","t":"lentis adhaerens bracchiis;"},{"loc":"15.7","t":"dum pecori lupus et nautis infestus Orion"},{"loc":"15.8","t":"turbaret hibernum mare"},{"loc":"15.9","t":"intonsosque agitaret Apollinis aura capillos,"},{"loc":"15.10","t":"fore hunc amorem mutuom,"},{"loc":"15.11","t":"o dolitura mea multum virtute Neaera:"},{"loc":"15.12","t":"nam siquid in Flacco viri est,"},{"loc":"15.13","t":"non feret adsiduas potiori te dare noctes"},{"loc":"15.14","t":"et quaeret iratus parem"},{"loc":"15.15","t":"nec semel offensi cedet constantia formae,"},{"loc":"15.16","t":"si certus intrarit dolor."},{"loc":"15.17","t":"Et tu, quicumque es felicior atque meo nunc"},{"loc":"15.18","t":"superbus incedis malo,"},{"loc":"15.19","t":"sis pecore et multa dives tellure licebit"},{"loc":"15.20","t":"tibique Pactolus fluat"},{"loc":"15.21","t":"nec te Pythagorae fallant arcana renati"},{"loc":"15.22","t":"formaque vincas Nirea,"},{"loc":"15.23","t":"heu heu, translatos alio maerebis amores,"},{"loc":"15.24","t":"ast ego vicissim risero."},{"loc":"16.1","t":"Altera iam teritur bellis civilibus aetas,"},{"loc":"16.2","t":"suis et ipsa Roma viribus ruit."},{"loc":"16.3","t":"Quam neque finitimi valuerunt perdere Marsi"},{"loc":"16.4","t":"minacis aut Etrusca Porsenae manus,"},{"loc":"16.5","t":"aemula nec virtus Capuae nec Spartacus acer"},{"loc":"16.6","t":"novisque rebus infidelis Allobrox"},{"loc":"16.7","t":"nec fera caerulea domuit Germania pube"},{"loc":"16.8","t":"parentibusque abominatus Hannibal:"},{"loc":"16.9","t":"inpia perdemus devoti sanguinis aetas"},{"loc":"16.10","t":"ferisque rursus occupabitur solum:"},{"loc":"16.11","t":"barbarus heu cineres insistet victor et Vrbem"},{"loc":"16.12","t":"eques sonante verberabit ungula,"},{"loc":"16.13","t":"quaeque carent ventis et solibus ossa Quirini,"},{"loc":"16.14","t":"(nefas videre) dissipabit insolens."},{"loc":"16.15","t":"Forte quid expediat communiter aut melior pars,"},{"loc":"16.16","t":"malis carere quaeritis laboribus;"},{"loc":"16.17","t":"nulla sit hac potior sententia: Phocaeorum"},{"loc":"16.18","t":"velut profugit exsecrata civitas"},{"loc":"16.19","t":"agros atque lares patrios habitandaque fana"},{"loc":"16.20","t":"apris reliquit et rapacibus lupis,"},{"loc":"16.21","t":"ire, pedes quocumque ferent, quocumque per undas"},{"loc":"16.22","t":"Notus vocabit aut protervos Africus."},{"loc":"16.23","t":"Sic placet? an melius quis habet suadere? Secunda"},{"loc":"16.24","t":"ratem occupare quid moramur alite?"},{"loc":"16.25","t":"sed iuremus in haec: “simul imis saxa renarint"},{"loc":"16.26","t":"vadis levata, ne redire sit nefas;"},{"loc":"16.27","t":"neu conversa domum pigeat dare lintea, quando"},{"loc":"16.28","t":"Padus Matina laverit cacumina,"},{"loc":"16.29","t":"in mare seu celsus procurrerit Appenninus"},{"loc":"16.30","t":"novaque monstra iunxerit libidine"},{"loc":"16.31","t":"mirus amor, iuvet ut tigris subsidere cervis,"},{"loc":"16.32","t":"adulteretur et columba miluo,"},{"loc":"16.33","t":"credula nec ravos timeant armenta leones"},{"loc":"16.34","t":"ametque salsa levis hircus aequora.”"},{"loc":"16.35","t":"haec et quae poterunt reditus abscindere dulcis"},{"loc":"16.36","t":"eamus omnis exsecrata civitas"},{"loc":"16.37","t":"aut pars indocili melior grege; mollis et exspes"},{"loc":"16.38","t":"inominata perpremat cubilia."},{"loc":"16.39","t":"Vos, quibus est virtus, muliebrem tollite luctum,"},{"loc":"16.40","t":"Etrusca praeter et volate litora."},{"loc":"16.41","t":"Nos manet Oceanus circum vagus: arva beata"},{"loc":"16.42","t":"petamus, arva divites et insulas,"},{"loc":"16.43","t":"reddit ubi cererem tellus inarata quotannis"},{"loc":"16.44","t":"et inputata floret usque vinea,"},{"loc":"16.45","t":"germinat et numquam fallentis termes olivae"},{"loc":"16.46","t":"suamque pulla ficus ornat arborem,"},{"loc":"16.47","t":"mella cava manant ex ilice, montibus altis"},{"loc":"16.48","t":"levis crepante lympha desilit pede."},{"loc":"16.49","t":"Illic iniussae veniunt ad mulctra capellae"},{"loc":"16.50","t":"refertque tenta grex amicus ubera"},{"loc":"16.51","t":"nec vespertinus circumgemit ursus ovile"},{"loc":"16.52","t":"nec intumescit alta viperis humus;"},{"loc":"16.53","t":"pluraque felices mirabimur, ut neque largis"},{"loc":"16.54","t":"aquosus Eurus arva radat imbribus,"},{"loc":"16.55","t":"pinguia nec siccis urantur semina glaebis,"},{"loc":"16.56","t":"utrumque rege temperante caelitum."},{"loc":"16.57","t":"Non huc Argoo contendit remige pinus"},{"loc":"16.58","t":"neque inpudica Colchis intulit pedem,"},{"loc":"16.59","t":"non huc Sidonii torserunt cornua nautae,"},{"loc":"16.60","t":"laboriosa nec cohors Vlixei."},{"loc":"16.61","t":"Nulla nocent pecori contagia, nullius astri"},{"loc":"16.62","t":"gregem aestuosa torret impotentia."},{"loc":"16.63","t":"Iuppiter illa piae secrevit litora genti,"},{"loc":"16.64","t":"ut inquinavit aere tempus aureum,"},{"loc":"16.65","t":"aere, dehinc ferro duravit saecula, quorum"},{"loc":"16.66","t":"piis secunda vate me datur fuga."},{"loc":"17.1","t":"“Iam iam efficaci do manus scientiae,"},{"loc":"17.2","t":"supplex et oro regna per Proserpinae,"},{"loc":"17.3","t":"per et Dianae non movenda numina,"},{"loc":"17.4","t":"per atque libros carminum valentium"},{"loc":"17.5","t":"refixa caelo devocare sidera,"},{"loc":"17.6","t":"Canidia: parce vocibus tandem sacris"},{"loc":"17.7","t":"citumque retro solve, solve turbinem."},{"loc":"17.8","t":"Movit nepotem Telephus Nereium,"},{"loc":"17.9","t":"in quem superbus ordinarat agmina"},{"loc":"17.10","t":"Mysorum et in quem tela acuta torserat."},{"loc":"17.11","t":"Unxere matres Iliae additum feris"},{"loc":"17.12","t":"alitibus atque canibus homicidam Hectorem,"},{"loc":"17.13","t":"postquam relictis moenibus rex procidit"},{"loc":"17.14","t":"heu pervicacis ad pedes Achillei."},{"loc":"17.15","t":"Saetosa duris exuere pellibus"},{"loc":"17.16","t":"laboriosi remiges Vlixei"},{"loc":"17.17","t":"volente Circa membra; tunc mens et sonus"},{"loc":"17.18","t":"relapsus atque notus in voltus honor."},{"loc":"17.19","t":"Dedi satis superque poenarum tibi,"},{"loc":"17.20","t":"amata nautis multum et institoribus."},{"loc":"17.21","t":"Fugit iuventas et verecundus color"},{"loc":"17.22","t":"reliquit ossa pelle amicta lurida,"},{"loc":"17.23","t":"tuis capillus albus est odoribus,"},{"loc":"17.24","t":"nullum a labore me reclinat otium;"},{"loc":"17.25","t":"urget diem nox et dies noctem neque est"},{"loc":"17.26","t":"levare tenta spiritu praecordia."},{"loc":"17.27","t":"Ergo negatum vincor ut credam miser,"},{"loc":"17.28","t":"Sabella pectus increpare carmina"},{"loc":"17.29","t":"caputque Marsa dissilire nenia."},{"loc":"17.30","t":"Quid amplius vis? o mare et terra, ardeo,"},{"loc":"17.31","t":"quantum neque atro delibutus Hercules"},{"loc":"17.32","t":"Nessi cruore nec Sicana fervida"},{"loc":"17.33","t":"virens in Aetna flamma; tu, donec cinis"},{"loc":"17.34","t":"iniuriosis aridus ventis ferar,"},{"loc":"17.35","t":"cales venenis officina Colchicis."},{"loc":"17.36","t":"Quae finis aut quod me manet stipendium?"},{"loc":"17.37","t":"effare; iussas cum fide poenas luam,"},{"loc":"17.38","t":"paratus expiare, seu poposceris"},{"loc":"17.39","t":"centum iuvencos sive mendaci lyra"},{"loc":"17.40","t":"voles sonare: “tu pudica, tu proba"},{"loc":"17.41","t":"perambulabis astra sidus aureum.”"},{"loc":"17.42","t":"infamis Helenae Castor offensus vice"},{"loc":"17.43","t":"fraterque magni Castoris, victi prece,"},{"loc":"17.44","t":"adempta vati reddidere lumina:"},{"loc":"17.45","t":"et tu, potes nam, solve me dementia,"},{"loc":"17.46","t":"o nec paternis obsoleta sordibus"},{"loc":"17.47","t":"neque in sepulcris pauperum prudens anus"},{"loc":"17.48","t":"novendialis dissipare pulveres."},{"loc":"17.49","t":"Tibi hospitale pectus et purae manus"},{"loc":"17.50","t":"tuosque venter Pactumeius et tuo"},{"loc":"17.51","t":"cruore rubros obstetrix pannos lavit,"},{"loc":"17.52","t":"utcumque fortis exsilis puerpera.”"},{"loc":"17.53","t":"“quid obseratis auribus fundis preces?"},{"loc":"17.54","t":"non saxa nudis surdiora navitis"},{"loc":"17.55","t":"Neptunus alto tundit hibernus salo."},{"loc":"17.56","t":"Inultus ut tu riseris Cotytia"},{"loc":"17.57","t":"volgata, sacrum liberi Cupidinis,"},{"loc":"17.58","t":"et Esquilini pontifex venefici"},{"loc":"17.59","t":"inpune ut Vrbem nomine inpleris meo?"},{"loc":"17.60","t":"quid proderat ditasse Paelignas anus"},{"loc":"17.61","t":"velociusve miscuisse toxicum?"},{"loc":"17.62","t":"sed tardiora fata te votis manent:"},{"loc":"17.63","t":"ingrata misero vita ducenda est in hoc,"},{"loc":"17.64","t":"novis ut usque suppetas laboribus."},{"loc":"17.65","t":"Optat quietem Pelopis infidi pater,"},{"loc":"17.66","t":"egens benignae Tantalus semper dapis,"},{"loc":"17.67","t":"optat Prometheus obligatus aliti,"},{"loc":"17.68","t":"optat supremo collocare Sisyphus"},{"loc":"17.69","t":"in monte saxum; sed vetant leges Iovis."},{"loc":"17.70","t":"Voles modo altis desilire turribus,"},{"loc":"17.71","t":"frustraque vincla gutturi innectes tuo"},{"loc":"17.72","t":"modo ense pectus Norico recludere"},{"loc":"17.73","t":"fastidiosa tristis aegrimonia."},{"loc":"17.74","t":"Vectabor umeris tunc ego inimicis eques"},{"loc":"17.75","t":"meaeque terra cedet insolentiae."},{"loc":"17.76","t":"An quae movere cereas imagines,"},{"loc":"17.77","t":"ut ipse nosti curiosus, et polo"},{"loc":"17.78","t":"deripere lunam vocibus possim meis,"},{"loc":"17.79","t":"possim crematos excitare mortuos"},{"loc":"17.80","t":"desiderique temperare pocula,"},{"loc":"17.81","t":"plorem artis in te nil agentis exitus?”"}],"stats":{"units":625,"words":3003}}