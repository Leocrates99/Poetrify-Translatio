"dict": {
"xerampelinae": {
"pos": "sostantivo",
"definition": "xērampelinae ārum, f, chrampe/linai (like dry vine-leaves; sc. vestes), dark-red clothes, dark dresses, Iu."
},
"xiphias": {
"pos": "sostantivo",
"definition": "xiphiās ae, m, cifi/as, a sword-fish: durus, O."
},
"xystus": {
"pos": "sostantivo",
"definition": "xystus ī, m, custo/s, a covered colonnade for winter exercise; hence, an open colonnade, garden-terrace, shaded walk: inambulare in xysto, C., Ph."
}
}
