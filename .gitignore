# Configurazione locale di Claude Code (non serve online)
.claude/

# Backup generati da _build/prune.py (recuperabili, 17 MB inutili nel repo).
# Gli script di build restano invece versionati per riproducibilità.
_build/backup/

# Cache e artefatti di build Python
__pycache__/
*.pyc
_build/_unresolved_*.json

# Record unificati (P1.1): output rigenerabile da _build/build_unified.py (~79 MB).
# Deterministico dagli shard + _id_map + ledger; diventerà canonico dopo F2/F3.
# Per ora si rigenera, non si versiona (come gli altri artefatti pesanti sopra).
data/*/unified/

# Fonti normalizzate (P1.2) + cache dei download esterni: rigenerabili dagli
# script _build/sources/*.py. Versionati gli script, non gli output pesanti.
_build/sources/normalized/
_build/sources/cache/

# Ramo CORPUS: cache dei TEI-XML scaricati da Perseus. Rigenerabile con
# _build/import_corpus.py (ri-scarica ciò che manca). Versionati lo script e i
# JSON normalizzati (data/corpus/), NON i sorgenti grezzi.
_build/corpus_cache/

# Fusione (S.2): input/batch e output grezzi degli agenti = intermedi rigenerabili.
# Versionato il PRODOTTO fuso data/*/fused/ (output LLM NON riproducibile) + gli script.
_build/fusion_input/
_build/fusion_output/

# Indice inverso dell'analizzatore (S.2 c): rigenerabile da build_forms_index.py.
data/*/forms/

# Cartella di staging creata dal workflow di deploy (solo in CI)
_site/

# File di sistema
Thumbs.db
desktop.ini
.DS_Store

# Lotti d'ingresso del giudizio sui genitivi (S.3/④): intermedi rigenerabili
# da genitivi_prep.py. Versionati gli script e i GIUDIZI (_build/reports/).
_build/genitivi_input/
